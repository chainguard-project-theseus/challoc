# Development container for challoc. Nothing in this repository builds or
# runs on macOS; everything happens inside this Wolfi image. See CLAUDE.md
# and the Makefile (`make dev`).
FROM cgr.dev/chainguard/wolfi-base

# Wolfi's `rust` (via libLLVM-22) is built against the versioned `glibc-2.44`
# stream, while wolfi-base pins the unversioned `glibc` 2.43 in the apk world
# file. apk satisfies `so:libc.so.6` with whichever is installed, so a plain
# `apk add rust` yields a rustc that cannot start. Move the four pinned glibc
# packages onto the 2.44 stream first, then install the toolchain.
RUN sed -i \
      -e 's/^glibc=.*/glibc-2.44/' \
      -e 's/^glibc-locale-posix=.*/glibc-2.44-locale-posix/' \
      -e 's/^ld-linux=.*/ld-linux-2.44/' \
      -e 's/^libcrypt1=.*/libcrypt1-2.44/' \
      /etc/apk/world \
 && apk add --no-cache glibc-2.44 glibc-2.44-locale-posix ld-linux-2.44 libcrypt1-2.44 \
 && apk add --no-cache \
      rust \
      build-base \
      gcc \
      jemalloc \
      git \
      cmake \
      tcl \
      openssl-dev \
      procps \
      memtier-benchmark \
      posix-libc-utils-2.44 \
      autoconf \
      ruby-3.4 \
      jemalloc-dev \
      yaml-dev \
      zlib-dev \
      libffi-dev \
      tzdata \
      tcmalloc-minimal \
      python-3.13 \
      py3.13-pip \
 && rustc --version && cargo --version && python3 --version \
 && test -f /usr/lib/libtcmalloc_minimal.so.4

# The last seven are for Ruby (contrib/ruby/build.sh, Phase 1 acceptance): a
# git checkout of Ruby needs autoconf and a base Ruby; the jemalloc header,
# yaml, zlib and libffi are what Wolfi's ruby-3.4.yaml environment gives its
# `--with-jemalloc` build (psych, zlib and fiddle extensions, and
# <jemalloc/jemalloc.h> as RUBY_ALTERNATIVE_MALLOC_HEADER); tzdata is for
# `make test-all` (test/ruby/test_time_tz.rb needs zone files). openssl-dev
# is already there for Valkey.
#
# tcmalloc-minimal (gperftools 2.18.1, no profiler hooks) is the fourth stock
# allocator of the benchmark harness (bench/lib.sh, Phase 2.5 task 1);
# python-3.13 and its pip are for bench/python-bench.sh (Wolfi has no
# free-threaded 3.13 package, checked 2026-09-18).

WORKDIR /src
CMD ["sh"]
