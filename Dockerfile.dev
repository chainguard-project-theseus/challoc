# Development container for challoc. Nothing in this repository builds or
# runs on macOS; everything happens inside this Wolfi image. See CLAUDE.md
# and the Makefile (`make dev`). One layer per consumer group below, so a
# package added for one harness does not rebuild the toolchain. The base
# image is pinned by digest: bump it deliberately, then run `make test`.
FROM cgr.dev/chainguard/wolfi-base@sha256:d59fd2d1d21e913b12a8d56064e9aaf61f818289bd18b17132a0c4fde2358cea

# Toolchain. `rust-1.98` is the stream contrib/wolfi/challoc.yaml builds the
# package with (Cargo.toml's `rust-version` is the lower, host-verified
# floor); `rust` alone would follow Wolfi's default stream when it moves.
# posix-libc-utils gives `getconf` (the harnesses read the page size and
# CLK_TCK), procps `ps`/`pgrep`.
RUN apk add --no-cache \
      rust-1.98 \
      build-base \
      gcc \
      git \
      cmake \
      procps \
      posix-libc-utils \
 && rustc --version && cargo --version && getconf PAGESIZE

# The stock allocators of the benchmark harness (bench/lib.sh): Wolfi's
# jemalloc and tcmalloc-minimal (gperftools 2.18.1, no profiler hooks);
# mimalloc is built from source by bench/build.sh.
RUN apk add --no-cache jemalloc tcmalloc-minimal \
 && test -f /usr/lib/libtcmalloc_minimal.so.4

# Valkey (tests/consumers/valkey-build.sh): tcl for its test
# suite, openssl-dev for BUILD_TLS=yes (Ruby's openssl extension uses it
# too), memtier_benchmark for the soak's second load generator
# (bench/valkey-soak.sh).
RUN apk add --no-cache tcl openssl-dev memtier-benchmark

# Ruby (tests/consumers/ruby-build.sh): a git checkout of Ruby
# needs autoconf and a base Ruby; the jemalloc header, yaml, zlib and libffi
# are what Wolfi's ruby-3.4.yaml environment gives its `--with-jemalloc`
# build (psych, zlib and fiddle extensions, and <jemalloc/jemalloc.h> as
# RUBY_ALTERNATIVE_MALLOC_HEADER); tzdata is for `make test-all`
# (test/ruby/test_time_tz.rb needs zone files).
RUN apk add --no-cache autoconf ruby-3.4 jemalloc-dev yaml-dev zlib-dev libffi-dev tzdata

# Python rows (bench/python-bench.sh): python-3.13 and its pip (Wolfi has
# no free-threaded 3.13 package).
RUN apk add --no-cache python-3.13 py3.13-pip \
 && python3 --version

# Node.js rows (bench/node-bench.sh): nodejs-22 is the node the harness
# measures. apache2-utils gives `ab`, the load generator of the Node.js and
# JVM server rows (Wolfi has no wrk or oha package).
RUN apk add --no-cache nodejs-22 apache2-utils \
 && node --version && ab -V | head -1

# JVM rows (bench/jvm-bench.sh): openjdk-21, the JDK (javac
# compiles bench/jvm/HttpBench.java at run time; it lives under
# /usr/lib/jvm/java-21-openjdk and is not on PATH, the script finds it);
# `ab` from the layer above is its load generator.
RUN apk add --no-cache openjdk-21 \
 && test -x /usr/lib/jvm/java-21-openjdk/bin/javac

# PostgreSQL rows (bench/postgres-bench.sh): postgresql-17
# carries initdb, pg_ctl, pgbench and postgres; postgresql-17-client carries
# psql.
RUN apk add --no-cache postgresql-17 postgresql-17-client \
 && pgbench --version && test -x /usr/bin/psql

WORKDIR /src
CMD ["sh"]
