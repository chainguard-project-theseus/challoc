# Kernel options for the virtme-ng floor cells (ci/vng-cell.sh), on top of
# `vng --kconfig`: what the allocator probes and what the tests exercise
# (USER_NS: lazy_bg checks that a single-threaded process can unshare).
# An option the kernel version does not have is dropped by olddefconfig.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_PSI=y
CONFIG_RSEQ=y
CONFIG_SCHED_MM_CID=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_ANON_VMA_NAME=y
CONFIG_USERFAULTFD=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FUTEX=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
