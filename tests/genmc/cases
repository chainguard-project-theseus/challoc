# The GenMC cases tests/genmc/run.sh runs, one per line:
#
#   name | template | models | constants | expected
#
# template: the .rs file in this directory the case instantiates.
# models: the memory models to run it under, each a run: rc11 (GenMC's
#   default), imm (--imm) or arm8 (--arm8).
# constants: Rust items written into the case's main.rs before the
#   template (each template names the constants it reads).
# expected: `pass` (GenMC explores at least one complete execution and
#   reports no error), or `fail` followed by one or more `| text`: GenMC
#   exits with its verification-error status (42) and its report has one
#   of the texts. A `fail` case is a control, like a loom model's
#   #[should_panic]: a mutant of the shipped code that the check must
#   reject.

# flags.rs (P5, vspec::flags): the dispatch byte.
flags1 | flags | rc11 imm | const PUBLISH: Ordering = Ordering::Release; const BUILDERS: usize = 1; const BITS: u8 = ROUTE; | pass
flags2 | flags | rc11 imm arm8 | const PUBLISH: Ordering = Ordering::Release; const BUILDERS: usize = 2; const BITS: u8 = ROUTE; | pass
flags_relaxed | flags | rc11 imm | const PUBLISH: Ordering = Ordering::Relaxed; const BUILDERS: usize = 1; const BITS: u8 = ROUTE; | fail | did not make | Non-atomic race
flags_badbit | flags | rc11 imm | const PUBLISH: Ordering = Ordering::Release; const BUILDERS: usize = 1; const BITS: u8 = ROUTE + 0x10; | fail | the joined byte | did not make

