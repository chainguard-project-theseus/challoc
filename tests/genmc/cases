count_split_cas_rival | count | rc11 imm | const MODE: u32 = 1; const SPLIT: bool = false; const SPLIT_CAS: bool = true; const RIVAL: bool = true; | fail | two heaps bound | count is not its tickets

# narenas.rs (vspec::count, vspec::entry): the arena count and table.
# RC11 only: under IMM and ARMv8 GenMC 0.20 stops on an internal check
# (`it != allocInfoMap_.end()`, in `ExecutionState::onFree`).
narenas | narenas | rc11 | const PUBLISH: Ordering = Ordering::Release; const ENTRY: Ordering = Ordering::Release; | pass
narenas_relaxed_store | narenas | rc11 | const PUBLISH: Ordering = Ordering::Relaxed; const ENTRY: Ordering = Ordering::Release; | fail | is not built
narenas_relaxed_entry | narenas | rc11 | const PUBLISH: Ordering = Ordering::Release; const ENTRY: Ordering = Ordering::Relaxed; | fail | Non-atomic race

# slotstate.rs (vspec::byte): the slot state byte's free step.
slotstate | slotstate | rc11 imm | const LOAD_STORE: bool = false; | pass
slotstate_load_store | slotstate | rc11 imm | const LOAD_STORE: bool = true; | fail | both passed

# bitmap.rs (P1, vspec::word): the slab bitmap and `live`. Two claimers run
# under RC11 only: under IMM and ARMv8, GenMC 0.20 stops on an internal
# check (`it != allocInfoMap_.end()`, in `ExecutionState::getAllocAccess`).
# Under ARMv8, GenMC 0.20 does not report bitmap_relaxed_release's race (the
# run passes), so that run is left out, and the ARMv8 run of
# bitmap_release_then_reserve checks its assertions only.
bitmap_release_then_reserve | bitmap | rc11 imm arm8 | const MODE: u32 = 0; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Release; | pass
bitmap_relaxed_release | bitmap | rc11 imm | const MODE: u32 = 0; const MUTANT: u32 = 1; const PUBLISH: Ordering = Ordering::Release; | fail | Non-atomic race
bitmap_relaxed_claim | bitmap | rc11 imm | const MODE: u32 = 0; const MUTANT: u32 = 2; const PUBLISH: Ordering = Ordering::Release; | fail | Non-atomic race
bitmap_two_claimers | bitmap | rc11 | const MODE: u32 = 1; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Release; | pass
bitmap_init_published | bitmap | rc11 imm | const MODE: u32 = 2; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Release; | pass
bitmap_relaxed_commit | bitmap | rc11 imm | const MODE: u32 = 2; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Relaxed; | fail | the hint missed the padding
bitmap_unclaimed_write | bitmap | rc11 imm | const MODE: u32 = 3; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Release; | fail | Non-atomic race

# litmus.rs (vspec::count): two shapes loom 0.7.2 cannot produce, as
# evidence for verus/WEAKMEM.md's loom limits. RC11 forbids load
# buffering, IMM and ARMv8 allow it.
lb | litmus | rc11 | const MODE: u32 = 0; const N: u32 = 0; | pass
lb_weak | litmus | imm arm8 | const MODE: u32 = 0; const N: u32 = 0; | fail | load buffering
hist3 | litmus | rc11 imm | const MODE: u32 = 1; const N: u32 = 3; | fail | store history
hist8 | litmus | rc11 imm | const MODE: u32 = 1; const N: u32 = 8; | fail | store history
