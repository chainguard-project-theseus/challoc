bitmap_relaxed_claim | bitmap | rc11 imm | const MODE: u32 = 0; const MUTANT: u32 = 2; const PUBLISH: Ordering = Ordering::Release; | fail | Non-atomic race
bitmap_two_claimers | bitmap | rc11 | const MODE: u32 = 1; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Release; | pass
bitmap_init_published | bitmap | rc11 imm | const MODE: u32 = 2; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Release; | pass
bitmap_relaxed_commit | bitmap | rc11 imm | const MODE: u32 = 2; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Relaxed; | fail | the hint missed the padding
bitmap_unclaimed_write | bitmap | rc11 imm | const MODE: u32 = 3; const MUTANT: u32 = 0; const PUBLISH: Ordering = Ordering::Release; | fail | Non-atomic race

