diff --git a/tests/unit/fork-drain.tcl b/tests/unit/fork-drain.tcl
new file mode 100644
index 0000000..91fa1ef
--- /dev/null
+++ b/tests/unit/fork-drain.tcl
@@ -0,0 +1,76 @@
+# The fork epoch's drain (contrib/redis 0006 of
+# chainguard-project-theseus/challoc). After a fork child exits, the values
+# written while it ran sit above the holes the epoch left, and while challoc
+# reports a size class still draining (challoc_cow_stat(CHALLOC_COW_DRAINING))
+# computeDefragCycles starts a defrag cycle whatever the fragmentation
+# thresholds. Here the thresholds are out of reach, so only that trigger can
+# start one: the defragmenter must move values once the child is gone.
+
+# challoc's fork-epoch figures, from the line its malloc_stats_print writes
+# ("fork epochs: epochs N open N ... drain_floors N"), as a dict; empty under
+# another allocator or a libchalloc.so.0 without fork epochs.
+proc fork_drain_stats {} {
+    foreach line [split [r memory malloc-stats] "\n"] {
+        if {[string match {fork epochs: *} $line]} {
+            return [string range $line [string length {fork epochs: }] end]
+        }
+    }
+    return {}
+}
+
+start_server {tags {"memefficiency external:skip needs:debug"}} {
+    set name {Active defrag drains the fork epoch whatever the thresholds}
+    if {![string match {*challoc*} [s mem_allocator]] || [fork_drain_stats] eq {}} {
+        # Not challoc, or a challoc without fork epochs: nothing to drain.
+        incr ::num_skipped
+        send_data_packet $::test_server_fd skip "$name (needs MALLOC=challoc with fork epochs)"
+    } else {
+        test $name {
+            r config set save ""
+            r config set appendonly no
+            r config set activedefrag yes
+            # No fragmentation reaches these: stock heuristics start no cycle.
+            r config set active-defrag-threshold-lower 1000
+            r config set active-defrag-threshold-upper 1000
+            r config set active-defrag-ignore-bytes 1000gb
+            r config set active-defrag-cycle-min 1
+            r config set active-defrag-cycle-max 25
+            # 64-byte values: raw strings, one size class.
+            r debug populate 200000 key 64
+            after 1000
+            assert_equal 0 [s active_defrag_hits]
+            assert_equal 0 [s active_defrag_running]
+
+            set epochs [dict get [fork_drain_stats] epochs]
+            r config set rdb-key-save-delay -5
+            r bgsave
+            wait_for_condition 50 100 {
+                [s rdb_bgsave_in_progress] == 1
+            } else {
+                fail "bgsave did not start"
+            }
+            # A tenth of the keys overwritten while the child runs.
+            r eval {
+                for i = 1, 20000 do
+                    redis.call('set', 'key:' .. math.random(0, 199999), string.rep('o', 64))
+                end
+            } 0
+            assert_equal 1 [s rdb_bgsave_in_progress]
+            # No cycle while the child runs.
+            assert_equal 0 [s active_defrag_hits]
+            r config set rdb-key-save-delay 0
+            waitForBgsave r
+            assert_equal [expr {$epochs + 1}] [dict get [fork_drain_stats] epochs]
+
+            wait_for_condition 100 100 {
+                [s active_defrag_hits] > 0
+            } else {
+                fail "no defrag cycle after the child exited: [fork_drain_stats]"
+            }
+            # The moves were the drain's: challoc's utilisation query asked
+            # for them.
+            assert_morethan [dict get [fork_drain_stats] drain_moves] 0
+            r config set activedefrag no
+        }
+    }
+}
diff --git a/tests/unit/fork-overwrite.tcl b/tests/unit/fork-overwrite.tcl
new file mode 100644
index 0000000..8e5c115
--- /dev/null
+++ b/tests/unit/fork-overwrite.tcl
@@ -0,0 +1,81 @@
+# Overwrites of every value type while a BGSAVE child runs (contrib/redis
+# 0006 of chainguard-project-theseus/challoc). Under MALLOC=challoc the fork
+# epoch is open while the child runs, and dbSetValue replaces the key's
+# object instead of swapping the new value into it, for collections too.
+# The dataset after the overwrites must equal the same overwrites done with
+# no child, and the snapshot must equal the dataset before them.
+
+proc fork_overwrite_populate {} {
+    r flushall
+    for {set i 0} {$i < 200} {incr i} {
+        r set raw:$i [string repeat [format %02d [expr {$i % 100}]] 32]
+        r set int:$i [expr {$i * 1000003}]
+        r hset h:$i a $i b [string repeat x 64] c [expr {$i * 7}]
+        r sadd s:$i m$i n$i [string repeat y 64]
+        r zadd z:$i $i m$i [expr {$i + 1}] n$i
+        r rpush l:$i [expr {$i % 17}] [expr {$i % 5}] [expr {$i % 11}]
+    }
+    # Hashes with field TTLs far in the future, so none expires in the test.
+    for {set i 0} {$i < 50} {incr i} {
+        r hset hfe:$i f1 v1 f2 [string repeat z 64] f3 v3
+        r hexpire hfe:$i 100000 FIELDS 2 f1 f2
+    }
+    r geoadd geo 13.361389 38.115556 palermo 15.087269 37.502669 catania
+    # Pad the dataset so that the save, at rdb-key-save-delay, outlasts the
+    # overwrites.
+    r debug populate 2000 pad 16
+}
+
+proc fork_overwrite_run {} {
+    for {set i 0} {$i < 50} {incr i} {
+        set j [expr {$i + 50}]
+        # Raw over raw, raw over int, and strings over collections.
+        r set raw:$i [string repeat q 64]
+        r set int:$i [string repeat w 64]
+        r set h:$j [string repeat e 64]
+        # A collection over a collection of the same and of another type.
+        r sunionstore s:$i s:$i s:$j
+        r sinterstore s:$j s:$i s:$j
+        r zunionstore z:$i 2 z:$i z:$j
+        r zrangestore z:$j z:$i 0 -1
+        r sort l:$i store l:$j
+        r sunionstore h:$i s:$j s:$i
+        r sunionstore hfe:$i s:$i
+        r geosearchstore l:$i geo fromlonlat 15 37 byradius 200 km
+        # The paths that do not go through dbSetValue, for completeness.
+        r copy s:$i z:[expr {$i + 100}] replace
+        r rename h:[expr {$i + 100}] l:[expr {$i + 100}]
+        r restore int:[expr {$i + 100}] 0 [r dump h:[expr {$i + 150}]] replace
+    }
+}
+
+start_server {tags {"other external:skip needs:debug"}} {
+    test {Overwrites of every value type while a BGSAVE child runs} {
+        r config set save ""
+        r config set appendonly no
+
+        fork_overwrite_populate
+        fork_overwrite_run
+        set expected [debug_digest]
+
+        fork_overwrite_populate
+        set before [debug_digest]
+        r config set rdb-key-save-delay 1000
+        r bgsave
+        wait_for_condition 50 100 {
+            [s rdb_bgsave_in_progress] == 1
+        } else {
+            fail "bgsave did not start"
+        }
+        fork_overwrite_run
+        # The child was alive for every overwrite above.
+        assert_equal 1 [s rdb_bgsave_in_progress]
+        assert_equal $expected [debug_digest]
+        r config set rdb-key-save-delay 0
+        waitForBgsave r
+        assert_equal $expected [debug_digest]
+        # The snapshot is the dataset from before the overwrites.
+        r debug reload nosave
+        assert_equal $before [debug_digest]
+    }
+}
