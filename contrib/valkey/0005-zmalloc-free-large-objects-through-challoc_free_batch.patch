diff --git a/src/zmalloc.c b/src/zmalloc.c
index 77ae364..b0ae887 100644
--- a/src/zmalloc.c
+++ b/src/zmalloc.c
@@ -502,10 +502,59 @@ static inline void zfree_internal(void *ptr, size_t size) {
 #endif
 }
 
+#ifdef USE_CHALLOC
+/* Deferred frees for teardown of large objects and keyspaces: between
+ * zfree_defer_begin() and zfree_defer_end() this thread's zfree and
+ * zfree_with_size calls collect their pointers and release them through
+ * challoc_free_batch, which runs free's checks on each pointer and releases
+ * slab slots grouped by slab instead of one by one through the thread cache. */
+#ifndef ZFREE_DEFER_N
+#define ZFREE_DEFER_N 4096
+#endif
+/* Weak: on a libchalloc.so.0 without the batch free it is null, nothing is
+ * deferred, and zfree frees at once as without this patch. */
+extern size_t challoc_free_batch(void **ptrs, size_t n) __attribute__((weak));
+static __thread void **zdefer_buf;
+static __thread size_t zdefer_len;
+static __thread int zdefer_depth;
+
+static void zfree_defer_flush(void) {
+    if (zdefer_len == 0) return;
+    update_zmalloc_stat_free(challoc_free_batch(zdefer_buf, zdefer_len));
+    zdefer_len = 0;
+}
+
+void zfree_defer_begin(void) {
+    if (challoc_free_batch == NULL) return;
+    if (zdefer_buf == NULL) {
+        zdefer_buf = malloc(ZFREE_DEFER_N * sizeof(void *));
+        if (zdefer_buf == NULL) return;
+    }
+    zdefer_depth++;
+}
+
+void zfree_defer_end(void) {
+    if (zdefer_depth == 0) return;
+    if (--zdefer_depth == 0) zfree_defer_flush();
+}
+
+/* Returns 1 when ptr was deferred. */
+static inline int zfree_defer(void *ptr) {
+    if (likely(zdefer_depth == 0)) return 0;
+    zdefer_buf[zdefer_len++] = ptr;
+    if (zdefer_len == ZFREE_DEFER_N) zfree_defer_flush();
+    return 1;
+}
+#else
+void zfree_defer_begin(void) {}
+void zfree_defer_end(void) {}
+#endif
+
 void zfree(void *ptr) {
     if (ptr == NULL) return;
 
 #ifdef USE_CHALLOC
+    if (zfree_defer(ptr)) return;
     /* One call: the free reports the usable size it verified, so the
      * zmalloc_size() query before the sized free is gone. */
     update_zmalloc_stat_free(challoc_free_usable(ptr));
@@ -532,6 +581,9 @@ void zfree(void *ptr) {
 /* Like zfree(), but doesn't call zmalloc_size(). */
 void zfree_with_size(void *ptr, size_t size) {
     if (ptr == NULL) return;
+#ifdef USE_CHALLOC
+    if (zfree_defer(ptr)) return;
+#endif
 
 #ifndef HAVE_MALLOC_SIZE
     unsigned char *prefix = (unsigned char *)ptr - PREFIX_SIZE;
diff --git a/src/zmalloc.h b/src/zmalloc.h
index 15472b9..13a5f65 100644
--- a/src/zmalloc.h
+++ b/src/zmalloc.h
@@ -140,6 +140,8 @@ __attribute__((malloc, alloc_size(1), noinline)) void *ztrycalloc(size_t size);
 __attribute__((alloc_size(2), noinline)) void *ztryrealloc(void *ptr, size_t size);
 void zfree(void *ptr);
 void zfree_with_size(void *ptr, size_t size);
+void zfree_defer_begin(void);
+void zfree_defer_end(void);
 void *zmalloc_usable(size_t size, size_t *usable);
 void *zcalloc_usable(size_t size, size_t *usable);
 void *zrealloc_usable(void *ptr, size_t size, size_t *usable);
