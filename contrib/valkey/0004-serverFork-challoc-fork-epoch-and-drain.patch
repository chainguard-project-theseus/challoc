From: challoc <noreply@chainguard.dev>
Subject: [PATCH] serverFork: challoc's fork epoch around a snapshot child,
 and the drain after it

Valkey 9.1.2 (tag 9.1.2, commit 7f1dffedff6de73058b2c2a389422b6ecd56c8fb),
on top of 0001 (MALLOC=challoc) and 0002, and, for embedded strings, 0003
(no write to an overwritten value's refcount when no module observes the
key event).

serverFork opens challoc's fork epoch (challoc_cow_begin,
<challoc/challoc.h>) just before forking a mutually exclusive child
(RDB, AOF rewrite, full sync, module fork) and resetChildState closes it
(challoc_cow_end) once the child is reaped, as does that fork's failure
path. A failed fork of any other child (the Lua debugger's, which may
run beside a save) leaves the save's epoch open. While the epoch is
open, challoc serves the parent's allocations from pages the child does
not share and hands out no block freed during it that the child may
still share, so the values written while the child runs copy no page.

The blocks written during the epoch then sit above the holes it left.
updateDefragCpuPercent runs a defrag cycle while challoc reports a size
class still draining (challoc_cow_stat(CHALLOC_COW_DRAINING)), at
active-defrag-cycle-max, whatever the fragmentation thresholds: challoc's
utilisation query tells the defragmenter to move those blocks back, and
the memory the epoch used returns within seconds. With activedefrag off
nothing moves them, and they return as the keys are overwritten or
deleted.

tests/unit/fork-drain.tcl checks the drain's trigger: with activedefrag
on and the fragmentation thresholds out of reach
(active-defrag-threshold-lower 1000, active-defrag-ignore-bytes 1000gb),
it overwrites a tenth of 200k 64-byte values while a BGSAVE child runs,
and requires active_defrag_hits to rise once the child exits, with
challoc's drain_moves (the "fork epochs:" line of MEMORY MALLOC-STATS)
counting the moves, and then that the drain ends with its work: challoc
reports no size class draining (drain_floors 0) and no cycle runs within
60 s, where challoc's drain window is 300 s. With the trigger taken out
it fails. It skips unless the server runs on challoc with fork epochs.

Both are compiled only under challoc (CHALLOC_COW, which <challoc/challoc.h>
defines), and the three entry points are weak references: on a
libchalloc.so.0 without fork epochs they are null and the server runs as
without this patch.

---
 src/defrag.c              | 19 ++++++++++++++++++-
 src/server.c              | 23 +++++++++++++++++++++++
 tests/unit/fork-drain.tcl | 85 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 126 insertions(+), 1 deletion(-)

diff --git a/src/defrag.c b/src/defrag.c
index ce5e6f7..f05f1fb 100644
--- a/src/defrag.c
+++ b/src/defrag.c
@@ -1258,6 +1258,10 @@ static void beginDefragCycle(void) {
 }
 
 
+#ifdef CHALLOC_COW
+/* Weak, as in server.c: a libchalloc.so.0 without fork epochs leaves it null. */
+#pragma weak challoc_cow_stat
+#endif
 #define INTERPOLATE(x, x1, x2, y1, y2) ((y1) + ((x) - (x1)) * ((y2) - (y1)) / ((x2) - (x1)))
 #define LIMIT(y, min, max) ((y) < (min) ? min : ((y) > (max) ? max : (y)))
 
@@ -1265,7 +1269,17 @@ static void beginDefragCycle(void) {
 static void updateDefragCpuPercent(void) {
     size_t frag_bytes;
     float frag_pct = getAllocatorFragmentation(&frag_bytes);
-    if (server.active_defrag_cpu_percent == 0) {
+#ifdef CHALLOC_COW
+    /* challoc's fork epoch drain: the values written while a fork child ran
+     * sit above the holes the epoch left. While challoc reports a size class
+     * still draining, a defrag cycle runs whatever the fragmentation
+     * thresholds, and challoc's utilization query has it move those values
+     * back. */
+    int cow_drain = challoc_cow_stat && challoc_cow_stat(CHALLOC_COW_DRAINING) > 0;
+#else
+    int cow_drain = 0;
+#endif
+    if (server.active_defrag_cpu_percent == 0 && !cow_drain) {
         if (frag_pct < server.active_defrag_threshold_lower ||
             frag_bytes < server.active_defrag_ignore_bytes) return;
     }
@@ -1275,6 +1289,9 @@ static void updateDefragCpuPercent(void) {
     int cpu_pct = INTERPOLATE(frag_pct, server.active_defrag_threshold_lower, server.active_defrag_threshold_upper,
                               server.active_defrag_cpu_min, server.active_defrag_cpu_max);
     cpu_pct = LIMIT(cpu_pct, server.active_defrag_cpu_min, server.active_defrag_cpu_max);
+    /* The drain is the fork epoch's memory coming back: run it at the most
+     * effort configured, so that it is over within a snapshot or two. */
+    if (cow_drain) cpu_pct = server.active_defrag_cpu_max;
 
     /* Normally we allow increasing the aggressiveness during a scan, but don't
      * reduce it, since we should not lower the aggressiveness when fragmentation
diff --git a/src/server.c b/src/server.c
index a14693c..8953a3b 100644
--- a/src/server.c
+++ b/src/server.c
@@ -844,7 +844,22 @@ int hasActiveChildProcess(void) {
     return server.child_pid != -1;
 }
 
+#ifdef CHALLOC_COW
+/* challoc's fork epoch (contrib/valkey 0004): open from just before the
+ * fork of a mutually exclusive child until resetChildState. Weak, so that
+ * the server also runs on a libchalloc.so.0 without fork epochs. */
+#pragma weak challoc_cow_begin
+#pragma weak challoc_cow_end
+static int cow_epoch_open = 0;
+#endif
+
 void resetChildState(void) {
+#ifdef CHALLOC_COW
+    if (cow_epoch_open) {
+        challoc_cow_end();
+        cow_epoch_open = 0;
+    }
+#endif
     server.child_type = CHILD_TYPE_NONE;
     server.child_pid = -1;
     server.stat_current_cow_peak = 0;
@@ -7081,6 +7096,9 @@ int serverFork(int purpose) {
 
     int childpid;
     ustime_t start = ustime();
+#ifdef CHALLOC_COW
+    if (challoc_cow_begin && isMutuallyExclusiveChildType(purpose) && challoc_cow_begin(0) == 0) cow_epoch_open = 1;
+#endif
     if ((childpid = valkey_fork()) == 0) {
         /* Child.
          *
@@ -7102,6 +7120,12 @@ int serverFork(int purpose) {
         /* Parent */
         if (childpid == -1) {
             int fork_errno = errno;
+#ifdef CHALLOC_COW
+            if (cow_epoch_open && isMutuallyExclusiveChildType(purpose)) {
+                challoc_cow_end();
+                cow_epoch_open = 0;
+            }
+#endif
             if (isMutuallyExclusiveChildType(purpose)) closeChildInfoPipe();
             errno = fork_errno;
             return -1;
diff --git a/tests/unit/fork-drain.tcl b/tests/unit/fork-drain.tcl
new file mode 100644
index 0000000..3ffc521
--- /dev/null
+++ b/tests/unit/fork-drain.tcl
@@ -0,0 +1,85 @@
+# The fork epoch's drain (contrib/valkey 0004 of
+# chainguard-project-theseus/challoc). After a fork child exits, the values
+# written while it ran sit above the holes the epoch left, and while challoc
+# reports a size class still draining (challoc_cow_stat(CHALLOC_COW_DRAINING))
+# updateDefragCpuPercent starts a defrag cycle whatever the fragmentation
+# thresholds. Here the thresholds are out of reach, so only that trigger can
+# start one: the defragmenter must move values once the child is gone.
+
+# challoc's fork-epoch figures, from the line its malloc_stats_print writes
+# ("fork epochs: epochs N open N ... drain_floors N"), as a dict; empty under
+# another allocator or a libchalloc.so.0 without fork epochs.
+proc fork_drain_stats {} {
+    foreach line [split [r memory malloc-stats] "\n"] {
+        if {[string match {fork epochs: *} $line]} {
+            return [string range $line [string length {fork epochs: }] end]
+        }
+    }
+    return {}
+}
+
+start_server {tags {"memefficiency external:skip needs:debug"}} {
+    set name {Active defrag drains the fork epoch whatever the thresholds}
+    if {![string match {*challoc*} [s mem_allocator]] || [fork_drain_stats] eq {}} {
+        # Not challoc, or a challoc without fork epochs: nothing to drain.
+        incr ::num_skipped
+        send_data_packet $::test_server_fd skip "$name (needs MALLOC=challoc with fork epochs)"
+    } else {
+        test $name {
+            r config set save ""
+            r config set appendonly no
+            r config set activedefrag yes
+            # No fragmentation reaches these: stock heuristics start no cycle.
+            r config set active-defrag-threshold-lower 1000
+            r config set active-defrag-threshold-upper 1000
+            r config set active-defrag-ignore-bytes 1000gb
+            r config set active-defrag-cycle-min 1
+            r config set active-defrag-cycle-max 25
+            # 64-byte values, embedded with their keys: one size class.
+            r debug populate 200000 key 64
+            after 1000
+            assert_equal 0 [s active_defrag_hits]
+            assert_equal 0 [s active_defrag_running]
+
+            set epochs [dict get [fork_drain_stats] epochs]
+            r config set rdb-key-save-delay -5
+            r bgsave
+            wait_for_condition 50 100 {
+                [s rdb_bgsave_in_progress] == 1
+            } else {
+                fail "bgsave did not start"
+            }
+            # A tenth of the keys overwritten while the child runs.
+            r eval {
+                for i = 1, 20000 do
+                    server.call('set', 'key:' .. math.random(0, 199999), string.rep('o', 64))
+                end
+            } 0
+            assert_equal 1 [s rdb_bgsave_in_progress]
+            # No cycle while the child runs.
+            assert_equal 0 [s active_defrag_hits]
+            r config set rdb-key-save-delay 0
+            waitForBgsave r
+            assert_equal [expr {$epochs + 1}] [dict get [fork_drain_stats] epochs]
+
+            wait_for_condition 100 100 {
+                [s active_defrag_hits] > 0
+            } else {
+                fail "no defrag cycle after the child exited: [fork_drain_stats]"
+            }
+            # The moves were the drain's: challoc's utilisation query asked
+            # for them.
+            assert_morethan [dict get [fork_drain_stats] drain_moves] 0
+            # The drain ends with its work, not at challoc's 300 s drain
+            # window: once nothing is left worth moving, challoc reports no
+            # size class draining (drain_floors 0) and the forced cycles stop.
+            wait_for_condition 600 100 {
+                [dict get [fork_drain_stats] drain_floors] == 0 &&
+                [s active_defrag_running] == 0
+            } else {
+                fail "the drain outlasted its work: [fork_drain_stats], active_defrag_running [s active_defrag_running]"
+            }
+            r config set activedefrag no
+        }
+    }
+}
