#!/usr/bin/env bash
# challoc-bench: drive the two Compute Engine VMs that produce challoc's
# reference benchmark numbers and hardware performance counters
# (docs/plan.md, Phase 1.5). One VM per architecture:
#
#   arm64  c4a-standard-16  Google Axion (Neoverse V2)   aarch64
#   amd64  c4-standard-16   Intel Xeon 6 (Granite Rapids) x86_64
#
# Both are created with --performance-monitoring-unit=standard, which
# exposes the core PMU (cycles, instructions, branch, L1/L2 cache, dTLB and
# iTLB events) to the guest; no bare-metal instance is needed.
#
# The VMs run the same Dockerfile.dev image as the Mac, through the same
# Makefile, so the toolchain is pinned identically everywhere. perf lives on
# the VM host (Wolfi has no perf package) and attaches to the container's
# process by PID; see `perf-stat` below.
#
#   bench/gce/challoc-bench create    arm64|amd64|all
#   bench/gce/challoc-bench provision arm64|amd64|all
#   bench/gce/challoc-bench sync      arm64|amd64|all      # rsync the working tree
#   bench/gce/challoc-bench run       arm64|amd64 CMD...   # run CMD in ~/challoc on the VM
#   bench/gce/challoc-bench make      arm64|amd64 ARGS...  # sync, then `make ARGS` on the VM
#   bench/gce/challoc-bench quick     arm64|amd64 [OLD=rev] [VAR=val...]
#                                                          # sync, then `make quick` (fast tier, ~2 min)
#   bench/gce/challoc-bench ab        arm64|amd64 VARIANTS='old=HEAD~1 new=HEAD jemalloc' [VAR=val...]
#                                                          # sync, then `make ab` (protocol tier)
#   bench/gce/challoc-bench quick-perf arm64|amd64 [OLD=rev] [ROWS='larson1 valkey1'] [VARIANTS='old new jemalloc']
#                                                          # sync, build old/new, then per-operation counters
#                                                          # (bench/gce/quick-perf.sh, perf attached from the host)
#   bench/gce/challoc-bench scorecard arm64|amd64 [REV=rev] [VAR=val...]
#                                                          # sync, `make scorecard` on the VM, fetch the file back
#   bench/gce/challoc-bench pmu-check arm64|amd64|all      # perf stat the six reference events
#   bench/gce/challoc-bench perf-stat arm64|amd64 'DOCKER_CMD'  # perf stat -p the container's process
#   bench/gce/challoc-bench fetch     arm64|amd64          # pull bench/results/* back from the VM
#                                                          # (never overwrites a newer local file)
#   bench/gce/challoc-bench ssh       arm64|amd64 [ARGS]
#   bench/gce/challoc-bench status    [arm64|amd64|all]
#   bench/gce/challoc-bench start|stop|delete arm64|amd64|all
#   bench/gce/challoc-bench session   start|stop [arm64|amd64|all]
#                                                          # the driving session's own start/stop, see below
#   bench/gce/challoc-bench matrix    [list|clean|CELL...]  # Phase 2.5 task 3: throwaway VMs per kernel
#                                                          # (5.10, 6.1, 6.8, hwe, 64 KiB pages), tests, delete
#
# Environment: CHALLOC_GCE_PROJECT (default: active gcloud project),
# CHALLOC_GCE_ZONE (default us-east4-a), CHALLOC_GCE_PREFIX (default
# challoc-bench). Stop every VM you start before an iteration ends: a
# 16-vCPU C4A or C4 costs roughly $0.70-0.90 per hour while running.
#
# Warm VMs during a driving session: when a driver runs many iterations back
# to back it starts the VMs once with `session start`, exports
# CHALLOC_GCE_WARM=1 for the iterations, and stops them once at the end with
# `session stop`. With CHALLOC_GCE_WARM set, `start` and `stop` are no-ops
# that say so, so an iteration following the "stop what you started" rule
# does not tear down the session's VMs; only `session stop` (or an unset
# variable) stops them.
set -euo pipefail

PROJECT="${CHALLOC_GCE_PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
# us-east4-a since 2026-09-17: us-central1-b returned ZONE_RESOURCE_POOL_EXHAUSTED
# on starts for weeks; that pair was deleted the same day.
ZONE="${CHALLOC_GCE_ZONE:-us-east4-a}"
PREFIX="${CHALLOC_GCE_PREFIX:-challoc-bench}"
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
REMOTE_DIR="challoc"

# Six events every Phase 1.5 result must be able to count. perf's generic
# names resolve to the right raw events on both Arm (armv8_pmuv3) and x86.
PMU_EVENTS="cycles,instructions,branch-misses,L1-dcache-load-misses,dTLB-load-misses,iTLB-load-misses"

die() { echo "challoc-bench: $*" >&2; exit 1; }
g() { gcloud --project="$PROJECT" "$@"; }

# Direct ssh/rsync use the key gcloud minted for `gcloud compute ssh`; run
# `challoc-bench ssh arm64 -- true` once if it does not exist yet.
SSH_KEY="${CHALLOC_GCE_SSH_KEY:-$HOME/.ssh/google_compute_engine}"
ssh_cmd() {
  [ -f "$SSH_KEY" ] || die "no ssh key at $SSH_KEY; run 'challoc-bench ssh arm64 -- true' once to have gcloud mint it"
  echo "ssh -i $SSH_KEY -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$HOME/.ssh/google_compute_known_hosts"
}

vm_name()    { echo "$PREFIX-$1"; }
vm_machine() { case "$1" in arm64) echo c4a-standard-16 ;; amd64) echo c4-standard-16 ;; *) die "unknown target $1" ;; esac; }
vm_image()   { case "$1" in arm64) echo ubuntu-2404-lts-arm64 ;; amd64) echo ubuntu-2404-lts-amd64 ;; esac; }
targets()    { case "${1:-all}" in all) echo "arm64 amd64" ;; arm64|amd64) echo "$1" ;; *) die "target must be arm64, amd64 or all" ;; esac; }

gssh() { # gssh TARGET [ssh args] -- runs gcloud compute ssh on the target VM
  local t="$1"; shift
  g compute ssh "$(vm_name "$t")" --zone="$ZONE" --quiet "$@"
}

# ssh_target prints "user@ip" for direct ssh/rsync, using the OS Login
# username so rsync does not need gcloud's wrapper.
ssh_target() {
  local t="$1" ip user
  ip="$(g compute instances describe "$(vm_name "$t")" --zone="$ZONE" \
        --format='value(networkInterfaces[0].accessConfigs[0].natIP)')"
  [ -n "$ip" ] || die "$(vm_name "$t") has no external IP (is it running?)"
  user="$(g compute os-login describe-profile --format='value(posixAccounts[0].username)')"
  echo "$user@$ip"
}

cmd_create() {
  for t in $(targets "${1:-all}"); do
    local name; name="$(vm_name "$t")"
    if g compute instances describe "$name" --zone="$ZONE" >/dev/null 2>&1; then
      echo "challoc-bench: $name already exists"; continue
    fi
    echo "challoc-bench: creating $name ($(vm_machine "$t")) in $ZONE"
    g compute instances create "$name" \
      --zone="$ZONE" \
      --machine-type="$(vm_machine "$t")" \
      --performance-monitoring-unit=standard \
      --image-family="$(vm_image "$t")" \
      --image-project=ubuntu-os-cloud \
      --boot-disk-size=100GB \
      --boot-disk-type=hyperdisk-balanced \
      --metadata=enable-oslogin=TRUE \
      --scopes=cloud-platform \
      --labels="owner=${USER},purpose=challoc-bench,arch=$t" &
  done
  wait
}

# provision installs Docker, perf for the running kernel, rsync, and opens
# perf_event access for unprivileged users. Idempotent.
cmd_provision() {
  for t in $(targets "${1:-all}"); do
    echo "challoc-bench: provisioning $(vm_name "$t")"
    gssh "$t" --command="bash -s" -- -T <<'REMOTE' &
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -qq
sudo apt-get install -y -qq docker.io make rsync git jq \
  linux-tools-common "linux-tools-$(uname -r)" >/dev/null
sudo usermod -aG docker "$USER"
sudo tee /etc/sysctl.d/90-challoc-perf.conf >/dev/null <<SYSCTL
kernel.perf_event_paranoid = -1
kernel.kptr_restrict = 0
SYSCTL
sudo sysctl -q --system
# GCE NICs carry a 1460-byte MTU; Docker's bridge defaults to 1500, so TLS
# fetches from inside a container (apk, cargo) stall on fragmented packets.
if ! grep -q '"mtu": 1460' /etc/docker/daemon.json 2>/dev/null; then
  echo '{ "mtu": 1460 }' | sudo tee /etc/docker/daemon.json >/dev/null
  sudo systemctl restart docker
fi
sudo systemctl enable --now docker >/dev/null
echo "== $(hostname): $(uname -m) $(uname -r)"
echo "== cpu: $(grep -m1 'model name' /proc/cpuinfo | sed 's/.*: //' || lscpu | grep -m1 'Model name' | sed 's/.*: *//')"
echo "== docker: $(sudo docker --version)"
echo "== perf: $(perf --version)"
echo "== pmu: $(ls /sys/bus/event_source/devices/ | tr '\n' ' ')"
REMOTE
  done
  wait
}

# sync mirrors the working tree, uncommitted changes included, with --delete:
# anything the VM keeps under ~/challoc that is not in the tree (logs) is
# removed, so VM-side logs belong in ~/logs. It warns when src/ (or the
# crate manifest) has uncommitted changes, because the library `make
# quick`/`make ab` measure as "tree" on the VM is then not HEAD.
cmd_sync() {
  local dirty
  dirty="$(git -C "$REPO" status --porcelain -- src Cargo.toml Cargo.lock build.rs 2>/dev/null || true)"
  if [ -n "$dirty" ]; then
    echo "challoc-bench: WARNING: uncommitted changes in the library sources are being synced (the VM's working tree != HEAD $(git -C "$REPO" rev-parse --short HEAD)):" >&2
    echo "$dirty" | sed 's/^/    /' >&2
  fi
  for t in $(targets "${1:-all}"); do
    local dest; dest="$(ssh_target "$t")"
    echo "challoc-bench: syncing $REPO -> $dest:$REMOTE_DIR"
    rsync -az --delete \
      --exclude=/target --exclude=/.ralph --exclude='/.tmp-*' --exclude='/.ralph-*.log' \
      -e "$(ssh_cmd)" \
      "$REPO/" "$dest:$REMOTE_DIR/" &
  done
  wait
}

cmd_run() {
  local t="$1"; shift
  [ $# -gt 0 ] || die "run needs a command"
  gssh "$t" --command="cd $REMOTE_DIR && $*" -- -T
}

cmd_make() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make $*"
}

# quoted ARGS...: each argument escaped for the remote (bash) shell, so
# VARIANTS='old=HEAD~1 new=HEAD' survives the ssh hop intact.
quoted() { local a out=; for a in "$@"; do out="$out $(printf '%q' "$a")"; done; echo "${out# }"; }

# quick / ab: sync, then the Makefile tier on the VM. Remaining arguments are
# VAR=value pairs for make (OLD=..., VARIANTS=..., ROUNDS=..., RESULT=...).
cmd_quick() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make quick $(quoted "$@")"
}
cmd_ab() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make ab $(quoted "$@")"
}

# quick-perf: the PERF=1 half of quick.sh with perf on the VM host. Sync,
# build old and new in the container (`make quick QUICK_BUILD_ONLY=1`, with
# OLD=/NEW= if given), then bench/gce/quick-perf.sh runs the rows detached
# and attaches `sudo perf stat --inherit -p` from the host; remaining
# arguments (ROWS=, VARIANTS=, EVENTS=, OUTDIR=) go to that script.
cmd_quick_perf() {
  local t="$1"; shift
  local a mk=() qp=()
  for a in "$@"; do case "$a" in OLD=*|NEW=*) mk+=("$a");; *) qp+=("$a");; esac; done
  cmd_sync "$t"
  cmd_run "$t" "make quick QUICK_BUILD_ONLY=1 $(quoted ${mk[@]+"${mk[@]}"})"
  cmd_run "$t" "bash bench/gce/quick-perf.sh $t $(quoted ${qp[@]+"${qp[@]}"})"
}

# scorecard: sync, `make scorecard` on the VM (bench/scorecard.sh appends
# one line to bench/results/scorecard-<arch>.md), then fetch the results
# directory back (fetch never overwrites a newer local file).
cmd_scorecard() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make scorecard $(quoted "$@")"
  cmd_fetch "$t"
}

# pmu-check proves the PMU is real: every reference event must count
# non-zero on a short busy loop. Fails loudly if any reads <not supported>
# or 0.
cmd_pmu_check() {
  for t in $(targets "${1:-all}"); do
    echo "== $(vm_name "$t")"
    gssh "$t" --command="bash -s" -- -T <<REMOTE
set -euo pipefail
perf stat -x, -e $PMU_EVENTS -- sh -c 'i=0; while [ \$i -lt 300000 ]; do i=\$((i+1)); done' 2>&1 \
  | awk -F, '{ printf "%-28s %s\n", \$3, \$1; if (\$1 == "<not supported>" || \$1 == "<not counted>" || \$1 == 0) bad = 1 } END { exit bad }' \
  && echo "pmu ok: all events counted" || { echo "pmu FAIL: an event did not count"; exit 1; }
REMOTE
  done
}

# perf-stat runs a `docker run` command line (the Makefile's DOCKER_RUN
# shape, or any docker run) detached on the VM, finds the benchmark process
# inside it from the host, and attaches perf stat to it until it exits.
# Usage: perf-stat arm64 'make run CMD="LD_PRELOAD=... larson ..."' is NOT
# supported (make runs docker in the foreground); pass a docker run line:
#   perf-stat arm64 'docker run --rm -v \$PWD:/src -w /src -v challoc-target-arm64:/src/target challoc-dev:arm64 sh -c "LD_PRELOAD=/src/target/release/libchalloc.so target/bench-bin/larson 5 8 1000 5000 100 4141 10"'
cmd_perf_stat() {
  local t="$1"; shift
  [ $# -gt 0 ] || die "perf-stat needs a docker run command line"
  # Detach by inserting -d right after `docker run`: appended at the end it
  # would land inside the container's `sh -c` arguments.
  local cmd="$*"
  case "$cmd" in "docker run "*) cmd="docker run -d ${cmd#docker run }";; *) die "perf-stat needs a command line starting with 'docker run'";; esac
  gssh "$t" --command="bash -s" -- -T <<REMOTE
set -euo pipefail
cd $REMOTE_DIR
cid=\$($cmd 2>/dev/null || { echo "docker run failed" >&2; exit 1; })
# wait for the first process inside the container, then attach to the whole cgroup via its pids
for i in \$(seq 1 50); do pid=\$(docker inspect -f '{{.State.Pid}}' "\$cid" 2>/dev/null || true); [ -n "\$pid" ] && [ "\$pid" != 0 ] && break; sleep 0.1; done
[ -n "\$pid" ] || { echo "container did not start" >&2; exit 1; }
echo "== perf stat on container \$cid (init pid \$pid), events: $PMU_EVENTS"
# perf must run as root to attach to the container's root-owned process
# (EACCES otherwise, whatever perf_event_paranoid says); it is stopped by
# killing its sleep child, since SIGINT to perf is swallowed by the
# restarted wait4 when perf has no terminal.
sudo perf stat -e $PMU_EVENTS --inherit -p "\$pid" -o /tmp/challoc-perf-stat.txt -- sleep 1000000 &
pp=\$!
docker wait "\$cid" >/dev/null
sudo pkill -f '^sleep 1000000$' 2>/dev/null; wait \$pp || true
cat /tmp/challoc-perf-stat.txt
docker logs "\$cid" 2>&1 | tail -20
docker rm -f "\$cid" >/dev/null 2>&1 || true
REMOTE
}

cmd_fetch() {
  local t="$1" src; src="$(ssh_target "$t")"
  # --update: a file the VM has that is older than the local copy is skipped,
  # so a results file edited locally after the run is never clobbered.
  rsync -az --update -i -e "$(ssh_cmd)" \
    "$src:$REMOTE_DIR/bench/results/" "$REPO/bench/results/" | sed 's/^/challoc-bench: fetch /'
}

cmd_ssh()    { local t="$1"; shift; gssh "$t" "$@"; }
cmd_status() {
  g compute instances list --filter="labels.purpose=challoc-bench" \
    --format='table(name,zone.basename(),machineType.basename(),status,networkInterfaces[0].accessConfigs[0].natIP)'
}
# start retries a few times: a zone can report ZONE_RESOURCE_POOL_EXHAUSTED for
# a minute or two and then admit the same instance.
start_one() {
  local name="$1" i
  for i in 1 2 3 4; do
    g compute instances start "$name" --zone="$ZONE" && return 0
    echo "challoc-bench: start of $name failed (attempt $i), retrying in 60 s" >&2
    sleep 60
  done
  g compute instances start "$name" --zone="$ZONE"
}
do_start()   { for t in $(targets "${1:-all}"); do start_one "$(vm_name "$t")" & done; wait; }
do_stop()    { for t in $(targets "${1:-all}"); do g compute instances stop   "$(vm_name "$t")" --zone="$ZONE" & done; wait; }
cmd_delete() { for t in $(targets "${1:-all}"); do g compute instances delete "$(vm_name "$t")" --zone="$ZONE" --quiet & done; wait; }
# start/stop defer to the session driver while CHALLOC_GCE_WARM is set.
warm() { [ -n "${CHALLOC_GCE_WARM:-}" ]; }
cmd_start() { if warm; then echo "challoc-bench: CHALLOC_GCE_WARM is set; the session driver owns the VMs, not starting (they should already be up: 'status')"; else do_start "$@"; fi; }
cmd_stop()  { if warm; then echo "challoc-bench: CHALLOC_GCE_WARM is set; the session driver owns the VMs, not stopping (use 'session stop' at the end of the session)"; else do_stop "$@"; fi; }
cmd_session() {
  local what="${1:-}"; shift || true
  case "$what" in
    start) do_start "$@"; echo "challoc-bench: session VMs are up; export CHALLOC_GCE_WARM=1 for the iterations, and run 'challoc-bench session stop' once at the end" ;;
    stop)  do_stop "$@"; echo "challoc-bench: session VMs stopped" ;;
    *) die "session needs start or stop" ;;
  esac
}

# ---------------------------------------------------------------------------
# matrix: the floor, proven (docs/plan.md Phase 2.5 task 3). For each cell
# (a kernel: image family or a kernel package installed on top of one,
# architecture, machine type) create a throwaway VM `challoc-matrix-<cell>`,
# provision Docker (the `provision` steps minus perf), sync the tree, run
# bench/gce/matrix-cell.sh detached on it (make image, make test, the probe
# line, make fuzz, make test-cgroup, plus the --privileged make test where
# the cell asks for it), fetch ~/logs into bench/results/matrix/<date>-<cell>.log
# and DELETE the VM, passed or failed, timed out or interrupted. Cells run
# MATRIX_JOBS (3) at a time with MATRIX_TIMEOUT (2700 s) each; the driver's
# exit trap deletes every challoc-matrix-* VM in the zone, and `matrix clean`
# does the same by hand. Nothing here measures anything: the machines are
# small and the numbers in the logs are not benchmark numbers.
#
#   challoc-bench matrix                 # every cell of the table below
#   challoc-bench matrix k510-amd64 64k-arm64
#   challoc-bench matrix list            # the table
#   challoc-bench matrix clean           # delete every challoc-matrix-* VM
#
# The table. `prep` installs another kernel on the image and reboots into
# it (ga: linux-generic, Ubuntu 24.04's 6.8 GA kernel, because the GCE
# image itself boots the 7.0 linux-gcp kernel since 2026; hwe:
# linux-generic-hwe-24.04, the 6.13+ non-GCE kernel, 7.0.0-31-generic in
# 2026-09; 64k: linux-generic-64k, the 6.8 GA kernel with 64 KiB pages);
# `extra` adds the privileged run: on k68-amd64 for a 6.8 host (where
# process_madvise with MADV_DONTNEED does not exist yet, whatever seccomp
# says) and on hwe-amd64, where the batch purge path and mseal light for
# real on a non-GCE kernel. The gcp-* cells run the image's own
# kernel, 7.0.0-1011-gcp, the reference VMs' kernel, on the small machines.
MATRIX_PREFIX="${CHALLOC_MATRIX_PREFIX:-challoc-matrix}"
MATRIX_JOBS="${MATRIX_JOBS:-3}"
MATRIX_TIMEOUT="${MATRIX_TIMEOUT:-2700}"
MATRIX_DATE="${MATRIX_DATE:-$(date +%F)}"
MATRIX_OUT="${MATRIX_OUT:-$REPO/bench/results/matrix}"
MATRIX_CELLS="k510-amd64 k61-amd64 k61-arm64 k68-amd64 k68-arm64 hwe-amd64 64k-arm64 gcp-amd64 gcp-arm64"

# cell_spec CELL -> "family project arch machine prep extra"
cell_spec() {
  case "$1" in
    k510-amd64) echo "debian-11 debian-cloud amd64 e2-standard-4 none none" ;;
    k61-amd64)  echo "debian-12 debian-cloud amd64 e2-standard-4 none none" ;;
    k61-arm64)  echo "debian-12-arm64 debian-cloud arm64 c4a-standard-4 none none" ;;
    k68-amd64)  echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3-standard-4 ga privileged" ;;
    k68-arm64)  echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 c4a-standard-4 ga none" ;;
    gcp-amd64)  echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3-standard-4 none none" ;;
    gcp-arm64)  echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 c4a-standard-4 none none" ;;
    hwe-amd64)  echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3-standard-4 hwe privileged" ;;
    64k-arm64)  echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 c4a-standard-4 64k none" ;;
    *) return 1 ;;
  esac
}

# latest_image FAMILY PROJECT: the family's current image, or, for a
# deprecated family (debian-11 since 2026), the newest deprecated image
# that is still READY. Prints the image name.
latest_image() {
  local fam="$1" proj="$2" name
  name="$(g compute images describe-from-family "$fam" --project="$proj" --format='value(name)' 2>/dev/null || true)"
  if [ -z "$name" ]; then
    name="$(g compute images list --project="$proj" --show-deprecated --filter="family=$fam AND status=READY" --format='value(name)' 2>/dev/null | sort | tail -1)"
  fi
  [ -n "$name" ] || return 1
  echo "$name"
}

matrix_vm() { echo "$MATRIX_PREFIX-$1"; }

# matrix_ssh CELL_IP_USER CMD...: direct ssh with the minted key. Matrix VMs
# are throwaway and GCE hands a deleted VM's external IP to the next one
# within minutes, so no host key is kept at all: `accept-new` with a
# known_hosts file rejected the recycled IPs' new keys and the cells sat
# in `matrix_wait_ssh` until their deadline.
matrix_ssh_opts() {
  echo "-i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=6 -o LogLevel=ERROR"
}
matrix_ssh() { # matrix_ssh user@ip CMD...
  local dest="$1"; shift
  # shellcheck disable=SC2046
  ssh -T $(matrix_ssh_opts) "$dest" "$@"
}

# matrix_wait_ssh user@ip DEADLINE: until `true` runs on the VM or the
# deadline (epoch seconds) passes.
matrix_wait_ssh() {
  local dest="$1" deadline="$2"
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if matrix_ssh "$dest" true 2>/dev/null; then return 0; fi
    sleep 10
  done
  return 1
}

matrix_delete_vm() {
  local vm="$1"
  if g compute instances describe "$vm" --zone="$ZONE" >/dev/null 2>&1; then
    g compute instances delete "$vm" --zone="$ZONE" --quiet >/dev/null 2>&1 \
      || g compute instances delete "$vm" --zone="$ZONE" --quiet >/dev/null 2>&1 \
      || echo "challoc-bench: matrix: WARNING: could not delete $vm; delete it by hand" >&2
  fi
}

# matrix_prep PREP: the remote script that installs the cell's kernel,
# points GRUB at it by title (the GCE kernel's version string sorts above
# the generic one, so the default entry alone would not do) and reboots.
matrix_prep_script() {
  case "$1" in
    ga)  echo 'pkg=linux-generic; pat=generic' ;;
    hwe) echo 'pkg=linux-generic-hwe-24.04; pat=generic' ;;
    64k) echo 'pkg=linux-generic-64k; pat=generic-64k' ;;
    *) return 1 ;;
  esac
  cat <<'PREP'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -qq
sudo apt-get install -y -qq "$pkg" >/dev/null
kver="$(ls /boot/vmlinuz-*-"$pat" | sed 's#.*/vmlinuz-##' | sort -V | tail -1)"
[ -n "$kver" ] || { echo "no $pat kernel installed"; exit 1; }
echo "== installed $kver"
# GCE's Ubuntu images boot without an initrd (40-force-partuuid.cfg): only
# the gcp kernel has the NVMe/virtio drivers built in, a generic kernel
# panics with "Unable to mount root fs". Clearing GRUB_FORCE_PARTUUID
# brings the initrd back.
printf 'GRUB_DEFAULT="Advanced options for Ubuntu>Ubuntu, with Linux %s"\nGRUB_FORCE_PARTUUID=\n' "$kver" \
  | sudo tee /etc/default/grub.d/99-challoc-matrix.cfg >/dev/null
sudo update-grub >/dev/null 2>&1
sudo grep -q "with Linux $kver" /boot/grub/grub.cfg || { echo "grub.cfg has no entry for $kver"; exit 1; }
sudo grep -q "initrd.*initrd.img-$kver" /boot/grub/grub.cfg || { echo "grub.cfg has no initrd line for $kver"; exit 1; }
echo "== rebooting into $kver"
(sleep 1; sudo systemctl reboot) >/dev/null 2>&1 </dev/null &
PREP
}

# The provision steps of cmd_provision minus perf (Debian has no
# linux-tools for its cloud kernel, and the cells measure nothing).
matrix_provision_script() {
  cat <<'REMOTE'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
if grep -q bullseye /etc/os-release; then
  # bullseye's LTS ended on 2026-08-31: its security suite's pool is gone
  # (404 on every package the image's lists name), so the cell installs
  # from main alone; if main leaves deb.debian.org too, the archive.
  echo "== bullseye: dropping the security and updates suites"
  sudo sed -i -e '/-security/d' -e '/bullseye-updates/d' -e '/backports/d' /etc/apt/sources.list
  sudo rm -f /etc/apt/sources.list.d/*security*.list
fi
if ! sudo apt-get update -qq; then
  echo "== apt-get update failed; switching to archive.debian.org"
  sudo sed -i 's#deb.debian.org/debian#archive.debian.org/debian#g' /etc/apt/sources.list
  sudo apt-get -o Acquire::Check-Valid-Until=false update -qq
fi
sudo apt-get install -y -qq docker.io make rsync jq curl >/dev/null
# git is optional on the host (the container has its own): on bullseye
# main's perl no longer matches the image's perl-base from the closed
# security suite, so git is not installable there.
sudo apt-get install -y -qq git >/dev/null 2>&1 || echo "== git not installable on this image (fine)"
sudo usermod -aG docker "$USER"
if ! grep -q '"mtu": 1460' /etc/docker/daemon.json 2>/dev/null; then
  echo '{ "mtu": 1460 }' | sudo tee /etc/docker/daemon.json >/dev/null
  sudo systemctl restart docker
fi
sudo systemctl enable --now docker >/dev/null
# The negative tests abort on purpose. Debian's core_pattern is `core` in
# the process's cwd, which for the container is the bind-mounted tree: a
# root-owned `core` there breaks every later `docker build` ("no permission
# to read from .../core"). Ubuntu pipes cores to apport. Discard them.
# Set the one key, not `sysctl --system`: that re-applies GCE's
# 60-gce-network-security.conf (net.ipv4.ip_forward = 0) over the value
# Docker set at start, and containers lose their networking.
echo 'kernel.core_pattern = |/bin/false' | sudo tee /etc/sysctl.d/90-challoc-matrix.conf >/dev/null
sudo sysctl -q -w 'kernel.core_pattern=|/bin/false' net.ipv4.ip_forward=1
mkdir -p ~/logs
echo "== $(hostname): $(uname -m) $(uname -r), page $(getconf PAGESIZE), $(. /etc/os-release; echo "$PRETTY_NAME")"
echo "== docker: $(sudo docker --version)"
REMOTE
}

# matrix_cell CELL: one cell start to finish, in a subshell of its own, its
# VM deleted on every exit path. Writes $MATRIX_OUT/$MATRIX_DATE-$CELL.log.
matrix_cell() {
  # cell, vm and log are deliberately not local: the EXIT trap below runs
  # when the cell's subshell exits, after this function has returned and
  # its locals are gone.
  cell="$1"
  local spec fam proj arch machine prep extra image disk dest user ip t0 deadline rc summary
  log="$MATRIX_OUT/$MATRIX_DATE-$cell.log"
  spec="$(cell_spec "$cell")" || die "matrix: unknown cell $cell (matrix list)"
  read -r fam proj arch machine prep extra <<<"$spec"
  vm="$(matrix_vm "$cell")"
  t0=$(date +%s); deadline=$((t0 + MATRIX_TIMEOUT))
  mkdir -p "$MATRIX_OUT"
  : > "$log"
  say() { echo "[driver $(date -u +%H:%M:%S)] $*" | tee -a "$log"; }
  # Whatever happens below, the VM goes.
  trap 'say "deleting $vm"; matrix_delete_vm "$vm"; say "deleted $vm"' EXIT
  trap 'say "signal: cell $cell interrupted"; exit 130' INT TERM HUP

  image="$(latest_image "$fam" "$proj")" || { say "no READY image in family $fam ($proj)"; echo "MATRIX cell=$cell image=none/$fam kernel=- page=- machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=0 outcome=FAIL reason=no-image" >> "$log"; return 1; }
  case "$machine" in e2-*|n1-*|n2-*) disk=pd-balanced ;; *) disk=hyperdisk-balanced ;; esac
  say "cell $cell: image $image ($fam, $proj), $arch, $machine, prep $prep, extra $extra, timeout ${MATRIX_TIMEOUT}s"
  matrix_delete_vm "$vm"
  if ! g compute instances create "$vm" --zone="$ZONE" --machine-type="$machine" \
        --image="$image" --image-project="$proj" \
        --boot-disk-size=50GB --boot-disk-type="$disk" \
        --metadata=enable-oslogin=TRUE --scopes=cloud-platform \
        --labels="owner=${USER},purpose=challoc-matrix,arch=$arch,cell=$cell" >>"$log" 2>&1; then
    say "create failed for $vm"; echo "MATRIX cell=$cell image=$image kernel=- page=- machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=create" >> "$log"; return 1
  fi
  ip="$(g compute instances describe "$vm" --zone="$ZONE" --format='value(networkInterfaces[0].accessConfigs[0].natIP)')"
  user="$(g compute os-login describe-profile --format='value(posixAccounts[0].username)')"
  dest="$user@$ip"
  say "created $vm at $ip; waiting for ssh"
  if ! matrix_wait_ssh "$dest" "$deadline"; then say "ssh never came up"; echo "MATRIX cell=$cell image=$image kernel=- page=- machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=no-ssh" >> "$log"; return 1; fi
  say "up: $(matrix_ssh "$dest" 'echo "$(uname -m) $(uname -r) page $(getconf PAGESIZE)"' 2>&1)"

  if [ "$prep" != none ]; then
    local boot0 boot1=
    boot0="$(matrix_ssh "$dest" cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
    say "prep $prep: installing the kernel and rebooting (boot id $boot0)"
    matrix_prep_script "$prep" | matrix_ssh "$dest" bash -s >>"$log" 2>&1 || { say "prep failed"; echo "MATRIX cell=$cell image=$image kernel=$(matrix_ssh "$dest" uname -r 2>/dev/null) page=- machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=prep" >> "$log"; return 1; }
    # ssh keeps answering for a while after the reboot is issued: wait for
    # a new boot id, not merely for a connection.
    while [ "$(date +%s)" -lt "$deadline" ]; do
      sleep 10
      boot1="$(matrix_ssh "$dest" cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
      [ -n "$boot1" ] && [ "$boot1" != "$boot0" ] && break
      boot1=
    done
    if [ -z "$boot1" ]; then say "the VM did not come back with a new boot id after the reboot"; echo "MATRIX cell=$cell image=$image kernel=- page=- machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=reboot" >> "$log"; return 1; fi
    local kp; kp="$(matrix_ssh "$dest" 'echo "$(uname -r) $(getconf PAGESIZE)"' 2>/dev/null || true)"
    say "after reboot: $kp"
    case "$prep:$kp" in
      64k:6.8.*-generic-64k\ 65536) ;;
      ga:6.8.*-generic\ 4096) ;;
      hwe:6.8.*) say "the hwe kernel is still 6.8 (got: $kp)"; echo "MATRIX cell=$cell image=$image kernel=${kp% *} page=${kp##* } machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=wrong-kernel" >> "$log"; return 1 ;;
      hwe:*-generic\ 4096) ;;
      *) say "the VM did not boot the $prep kernel (got: $kp)"; echo "MATRIX cell=$cell image=$image kernel=${kp% *} page=${kp##* } machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=wrong-kernel" >> "$log"; return 1 ;;
    esac
  fi

  say "provisioning"
  matrix_provision_script | matrix_ssh "$dest" bash -s >>"$log" 2>&1 || { say "provision failed"; echo "MATRIX cell=$cell image=$image kernel=$(matrix_ssh "$dest" uname -r 2>/dev/null) page=- machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=provision" >> "$log"; return 1; }
  say "syncing the tree"
  # shellcheck disable=SC2046
  rsync -az --delete --exclude=/target --exclude=/.ralph --exclude='/.tmp-*' --exclude='/.ralph-*.log' \
    -e "ssh $(matrix_ssh_opts)" "$REPO/" "$dest:$REMOTE_DIR/" >>"$log" 2>&1 || { say "sync failed"; echo "MATRIX cell=$cell image=$image kernel=- page=- machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=sync" >> "$log"; return 1; }
  say "running matrix-cell.sh detached (a new login, so the docker group applies)"
  matrix_ssh "$dest" "rm -f ~/logs/done; (setsid nohup bash -c 'bash ~/challoc/bench/gce/matrix-cell.sh $cell $image $extra; echo \$? > ~/logs/done' > ~/logs/matrix.log 2>&1 < /dev/null &); sleep 1; echo launched" >>"$log" 2>&1 || say "launch ssh returned nonzero (the run may still be going)"
  # Poll for the done marker until the deadline; a lost connection while
  # polling is not fatal.
  rc=timeout
  while [ "$(date +%s)" -lt "$deadline" ]; do
    sleep 30
    local d; d="$(matrix_ssh "$dest" 'if [ -f ~/logs/done ]; then echo "DONE=$(cat ~/logs/done)"; fi' 2>/dev/null || true)"
    case "$d" in
      DONE=*) rc="${d#DONE=}"; break ;;
    esac
  done
  say "run finished: rc=$rc after $(( $(date +%s) - t0 )) s; fetching ~/logs"
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/challoc-matrix-$cell.XXXXXX")"
  # shellcheck disable=SC2046
  rsync -az -e "ssh $(matrix_ssh_opts)" "$dest:logs/" "$tmp/" >>"$log" 2>&1 || say "fetch failed (partial logs)"
  {
    echo
    echo "==================== ~/logs/matrix.log on $vm ===================="
    cat "$tmp/matrix.log" 2>/dev/null || echo "(no matrix.log)"
    for f in image test probe probe-privileged fuzz test-cgroup test-privileged; do
      [ -f "$tmp/$f.log" ] || continue
      echo
      echo "==================== ~/logs/$f.log (last 60 lines) ===================="
      tail -n 60 "$tmp/$f.log"
    done
    # Every failed test's own output, for the results file's FAIL lines.
    if grep -q '^failures:' "$tmp/test.log" 2>/dev/null; then
      echo
      echo "==================== failures in make test ===================="
      awk '/^failures:$/ { on = 1 } on { print } /^test result:/ { on = 0 }' "$tmp/test.log" | head -n 400
      # With --nocapture the panic message is not in that block: it went to
      # stderr as it happened, on the line after `panicked at`. Every panic
      # (the should_panic tests' expected ones included) with its message.
      echo "-- every panic with its message:"
      grep -A1 "panicked at" "$tmp/test.log" | grep -v '^--$' | head -n 300
    fi
  } >> "$log"
  rm -rf "$tmp"
  if [ "$rc" = timeout ]; then
    echo "MATRIX cell=$cell image=$image kernel=? page=? machine=$machine tests=- fuzz=- cgroup=- privileged=- wall=$(( $(date +%s) - t0 )) outcome=FAIL reason=timeout" >> "$log"
  fi
  summary="$(grep '^MATRIX ' "$log" | tail -1)"
  say "$summary"
  case "$summary" in *outcome=PASS*) return 0 ;; *) return 1 ;; esac
}

matrix_clean() {
  local vms
  vms="$(g compute instances list --filter="name~^$MATRIX_PREFIX-" --format='value(name)' 2>/dev/null || true)"
  [ -n "$vms" ] || { echo "challoc-bench: matrix: no $MATRIX_PREFIX-* VM exists"; return 0; }
  echo "challoc-bench: matrix: deleting $(echo "$vms" | tr '\n' ' ')"
  for v in $vms; do matrix_delete_vm "$v" & done
  wait
}

cmd_matrix() {
  local what="${1:-}"
  case "$what" in
    list)
      printf '%-11s %-22s %-16s %-6s %-15s %-5s %s\n' cell family project arch machine prep extra
      for c in $MATRIX_CELLS; do printf '%-11s %s\n' "$c" "$(cell_spec "$c" | awk '{ printf "%-22s %-16s %-6s %-15s %-5s %s", $1, $2, $3, $4, $5, $6 }')"; done
      return 0 ;;
    clean) matrix_clean; return 0 ;;
  esac
  local cells="${*:-$MATRIX_CELLS}" c pids= failed=0
  for c in $cells; do cell_spec "$c" >/dev/null || die "matrix: unknown cell $c (matrix list)"; done
  mkdir -p "$MATRIX_OUT"
  echo "challoc-bench: matrix: cells: $cells; $MATRIX_JOBS at a time, ${MATRIX_TIMEOUT}s each; logs in $MATRIX_OUT/$MATRIX_DATE-<cell>.log"
  # On any exit: stop the cells (their own traps delete their VMs), then
  # sweep the zone for anything left.
  # `set -e` applies inside the trap too: every step here must not fail
  # (a pkill that finds no children returns 1), or the sweep never runs.
  trap 'echo "challoc-bench: matrix: cleaning up"; for p in $pids; do pkill -TERM -P "$p" 2>/dev/null || true; kill -TERM "$p" 2>/dev/null || true; done; wait 2>/dev/null || true; matrix_clean || true; g compute instances list --filter="name~^$MATRIX_PREFIX-" 2>/dev/null || true' EXIT
  trap 'exit 130' INT TERM HUP
  for c in $cells; do
    while [ "$(jobs -rp | wc -l | tr -d ' ')" -ge "$MATRIX_JOBS" ]; do sleep 15; done
    ( matrix_cell "$c" ) &
    pids="$pids $!"
    sleep 5
  done
  for p in $pids; do wait "$p" || failed=$((failed + 1)); done
  echo
  echo "challoc-bench: matrix: summary ($MATRIX_DATE)"
  for c in $cells; do grep -h '^MATRIX ' "$MATRIX_OUT/$MATRIX_DATE-$c.log" 2>/dev/null | tail -1 || echo "MATRIX cell=$c outcome=MISSING"; done
  [ "$failed" = 0 ]
}

cmd="${1:-}"; shift || true
case "$cmd" in
  create)    cmd_create "$@" ;;
  provision) cmd_provision "$@" ;;
  sync)      cmd_sync "$@" ;;
  run)       cmd_run "$@" ;;
  make)      cmd_make "$@" ;;
  quick)     cmd_quick "$@" ;;
  ab)        cmd_ab "$@" ;;
  quick-perf) cmd_quick_perf "$@" ;;
  scorecard) cmd_scorecard "$@" ;;
  pmu-check) cmd_pmu_check "$@" ;;
  perf-stat) cmd_perf_stat "$@" ;;
  fetch)     cmd_fetch "$@" ;;
  ssh)       cmd_ssh "$@" ;;
  status)    cmd_status ;;
  start)     cmd_start "$@" ;;
  stop)      cmd_stop "$@" ;;
  session)   cmd_session "$@" ;;
  delete)    cmd_delete "$@" ;;
  matrix)    cmd_matrix "$@" ;;
  *) sed -n '2,55p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
