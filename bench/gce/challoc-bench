#!/usr/bin/env bash
# challoc-bench: drive the two Compute Engine VMs that produce challoc's
# reference benchmark numbers and hardware performance counters
# (docs/plan.md, Phase 1.5). One VM per architecture:
#
#   arm64  c4a-standard-16  Google Axion (Neoverse V2)   aarch64
#   amd64  c4-standard-16   Intel Xeon Platinum 8581C (Emerald Rapids) x86_64
#
# Both are created with --performance-monitoring-unit=standard, which
# exposes the core PMU (cycles, instructions, branch, L1/L2 cache, dTLB and
# iTLB events) to the guest; no bare-metal instance is needed.
#
# The VMs run the same Dockerfile.dev image as the Mac, through the same
# Makefile, so the toolchain is pinned identically everywhere. perf lives on
# the VM host (Wolfi has no perf package) and attaches to the container's
# process by PID; see `perf-stat` below.
#
#   bench/gce/challoc-bench create    arm64|amd64|all
#   bench/gce/challoc-bench provision arm64|amd64|all
#   bench/gce/challoc-bench sync      arm64|amd64|all      # rsync the working tree
#   bench/gce/challoc-bench run       arm64|amd64 CMD...   # run CMD in ~/challoc on the VM
#   bench/gce/challoc-bench make      arm64|amd64 ARGS...  # sync, then `make ARGS` on the VM
#   bench/gce/challoc-bench quick     arm64|amd64 [OLD=rev] [VAR=val...]
#                                                          # sync, then `make quick` (fast tier, ~2 min)
#   bench/gce/challoc-bench ab        arm64|amd64 VARIANTS='old=HEAD~1 new=HEAD jemalloc' [VAR=val...]
#                                                          # sync, then `make ab` (protocol tier)
#   bench/gce/challoc-bench quick-perf arm64|amd64 [OLD=rev] [ROWS='larson1 valkey1'] [VARIANTS='old new jemalloc']
#                                                          # sync, build old/new, then per-operation counters
#                                                          # (bench/gce/quick-perf.sh, perf attached from the host)
#   bench/gce/challoc-bench scorecard arm64|amd64 [REV=rev] [VAR=val...]
#                                                          # sync, `make scorecard` on the VM, fetch the file back
#   bench/gce/challoc-bench pmu-check arm64|amd64|all      # perf stat the six reference events
#   bench/gce/challoc-bench perf-stat arm64|amd64 'DOCKER_CMD'  # perf stat -p the container's process
#   bench/gce/challoc-bench fetch     arm64|amd64          # pull bench/results/* back from the VM
#                                                          # (never overwrites a newer local file)
#   bench/gce/challoc-bench ssh       arm64|amd64 [ARGS]
#   bench/gce/challoc-bench status    # this prefix's VMs; every challoc-* VM when CHALLOC_GCE_PREFIX is unset
#   bench/gce/challoc-bench lanes     # every challoc-* VM grouped by prefix (lane), status, zone, uptime
#   bench/gce/challoc-bench start|stop|delete arm64|amd64|all
#   bench/gce/challoc-bench session   start|stop [arm64|amd64|all]
#                                                          # the driving session's own start/stop, see below
#   bench/gce/challoc-bench matrix    [list|clean|CELL...]  # Phase 2.5 task 3: throwaway VMs per kernel
#                                                          # (5.10, 6.1, 6.8, hwe, 64 KiB pages), tests, delete
#   bench/gce/challoc-bench matrix    cpu                  # Phase 2.5 task 4: the cpu-* cells (one machine
#                                                          # type each, tests + one scorecard run per CPU)
#   bench/gce/challoc-bench matrix    lab CELL | ssh CELL CMD | sync CELL  # keep one cell VM for experiments
#   bench/gce/challoc-bench matrix    cgos                 # Phase 2.5 task 14: the cgos-* cells, Chainguard OS
#                                                          # hosts (bootc, podman, no Docker); MATRIX_ADOPT=<vm>
#                                                          # runs a cell on an existing VM and keeps it
#
# Environment: CHALLOC_GCE_PROJECT (default: active gcloud project),
# CHALLOC_GCE_ZONE (default us-east4-a), CHALLOC_GCE_PREFIX (default
# challoc-bench). Stop every VM you start before an iteration ends: a
# 16-vCPU C4A or C4 costs roughly $0.70-0.90 per hour while running.
#
# Lanes: every subcommand names its VMs <CHALLOC_GCE_PREFIX>-<arch>, so a
# lane (CLAUDE.md, Environment) with CHALLOC_GCE_PREFIX=challoc-lane-b owns
# challoc-lane-b-arm64 and challoc-lane-b-amd64 and its matrix cells are
# challoc-lane-b-matrix-<cell> (CHALLOC_MATRIX_PREFIX overrides; the default
# prefix keeps challoc-matrix-<cell>); nothing it runs touches another
# prefix's VMs. The reference pair challoc-bench-{arm64,amd64} belongs to
# the coordinator on main, the only place `scorecard` runs.
#
# Warm VMs during a driving session: when a driver runs many iterations back
# to back it starts the VMs once with `session start`, exports
# CHALLOC_GCE_WARM=1 for the iterations, and stops them once at the end with
# `session stop`. With CHALLOC_GCE_WARM set, `start` and `stop` are no-ops
# that say so, so an iteration following the "stop what you started" rule
# does not tear down the session's VMs; only `session stop` (or an unset
# variable) stops them.
set -euo pipefail

PROJECT="${CHALLOC_GCE_PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
# us-east4-a since 2026-09-17: us-central1-b returned ZONE_RESOURCE_POOL_EXHAUSTED
# on starts for weeks; that pair was deleted the same day.
ZONE="${CHALLOC_GCE_ZONE:-us-east4-a}"
PREFIX="${CHALLOC_GCE_PREFIX:-challoc-bench}"
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
REMOTE_DIR="challoc"

# Six events every Phase 1.5 result must be able to count. perf's generic
# names resolve to the right raw events on both Arm (armv8_pmuv3) and x86.
PMU_EVENTS="cycles,instructions,branch-misses,L1-dcache-load-misses,dTLB-load-misses,iTLB-load-misses"

die() { echo "challoc-bench: $*" >&2; exit 1; }
g() { gcloud --project="$PROJECT" "$@"; }

# Direct ssh/rsync use the key gcloud minted for `gcloud compute ssh`; run
# `challoc-bench ssh arm64 -- true` once if it does not exist yet.
SSH_KEY="${CHALLOC_GCE_SSH_KEY:-$HOME/.ssh/google_compute_engine}"
ssh_cmd() {
  [ -f "$SSH_KEY" ] || die "no ssh key at $SSH_KEY; run 'challoc-bench ssh arm64 -- true' once to have gcloud mint it"
  echo "ssh -i $SSH_KEY -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$HOME/.ssh/google_compute_known_hosts"
}

vm_name()    { echo "$PREFIX-$1"; }
vm_machine() { case "$1" in arm64) echo c4a-standard-16 ;; amd64) echo c4-standard-16 ;; *) die "unknown target $1" ;; esac; }
vm_image()   { case "$1" in arm64) echo ubuntu-2404-lts-arm64 ;; amd64) echo ubuntu-2404-lts-amd64 ;; esac; }
targets()    { case "${1:-all}" in all) echo "arm64 amd64" ;; arm64|amd64) echo "$1" ;; *) die "target must be arm64, amd64 or all" ;; esac; }

gssh() { # gssh TARGET [ssh args] -- runs gcloud compute ssh on the target VM
  local t="$1"; shift
  g compute ssh "$(vm_name "$t")" --zone="$ZONE" --quiet "$@"
}

# ssh_target prints "user@ip" for direct ssh/rsync, using the OS Login
# username so rsync does not need gcloud's wrapper.
ssh_target() {
  local t="$1" ip user
  ip="$(g compute instances describe "$(vm_name "$t")" --zone="$ZONE" \
        --format='value(networkInterfaces[0].accessConfigs[0].natIP)')"
  [ -n "$ip" ] || die "$(vm_name "$t") has no external IP (is it running?)"
  user="$(g compute os-login describe-profile --format='value(posixAccounts[0].username)')"
  echo "$user@$ip"
}

cmd_create() {
  for t in $(targets "${1:-all}"); do
    local name; name="$(vm_name "$t")"
    if g compute instances describe "$name" --zone="$ZONE" >/dev/null 2>&1; then
      echo "challoc-bench: $name already exists"; continue
    fi
    echo "challoc-bench: creating $name ($(vm_machine "$t")) in $ZONE"
    g compute instances create "$name" \
      --zone="$ZONE" \
      --machine-type="$(vm_machine "$t")" \
      --performance-monitoring-unit=standard \
      --image-family="$(vm_image "$t")" \
      --image-project=ubuntu-os-cloud \
      --boot-disk-size=100GB \
      --boot-disk-type=hyperdisk-balanced \
      --metadata=enable-oslogin=TRUE \
      --scopes=cloud-platform \
      --labels="owner=${USER},purpose=challoc-bench,arch=$t,prefix=$PREFIX" &
  done
  wait
}

# provision installs Docker, perf for the running kernel, rsync, and opens
# perf_event access for unprivileged users. Idempotent.
cmd_provision() {
  local -a pids=() names=()
  for t in $(targets "${1:-all}"); do
    echo "challoc-bench: provisioning $(vm_name "$t")"
    gssh "$t" --command="bash -s" -- -T <<'REMOTE' &
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -qq
sudo apt-get install -y -qq docker.io make rsync git jq \
  linux-tools-common "linux-tools-$(uname -r)" >/dev/null
sudo usermod -aG docker "$USER"
sudo tee /etc/sysctl.d/90-challoc-perf.conf >/dev/null <<SYSCTL
kernel.perf_event_paranoid = -1
kernel.kptr_restrict = 0
SYSCTL
sudo sysctl -q --system
# GCE NICs carry a 1460-byte MTU; Docker's bridge defaults to 1500, so TLS
# fetches from inside a container (apk, cargo) stall on fragmented packets.
if ! grep -q '"mtu": 1460' /etc/docker/daemon.json 2>/dev/null; then
  echo '{ "mtu": 1460 }' | sudo tee /etc/docker/daemon.json >/dev/null
  sudo systemctl restart docker
fi
sudo systemctl enable --now docker >/dev/null
echo "== $(hostname): $(uname -m) $(uname -r)"
echo "== cpu: $(grep -m1 'model name' /proc/cpuinfo | sed 's/.*: //' || lscpu | grep -m1 'Model name' | sed 's/.*: *//')"
echo "== docker: $(sudo docker --version)"
echo "== perf: $(perf --version)"
echo "== pmu: $(ls /sys/bus/event_source/devices/ | tr '\n' ' ')"
REMOTE
    pids+=($!); names+=("$(vm_name "$t")")
  done
  # The exit code is the worst of the targets' (a VM still booting refuses
  # ssh; before 2026-09-20 that returned 0 and the next step ran unprovisioned).
  local i failed=
  for i in "${!pids[@]}"; do wait "${pids[$i]}" || failed="$failed ${names[$i]}"; done
  [ -z "$failed" ] || die "provision FAILED for:$failed"
}

# rsync_tree SSH_CMD DEST: the working tree to DEST:$REMOTE_DIR (the one
# rsync line `sync`, the matrix cells and `matrix sync` share). In a git
# worktree (a lane, CLAUDE.md) `.git` is a file naming the main
# repository's gitdir, which does not exist on the VM, where bench/quick.sh
# and bench/ab.sh `git archive` revisions; so a worktree ships the common
# .git directory (objects, refs, packed-refs, config) in its place and the
# worktree's own HEAD and index over it, and the VM's ~/challoc is a plain
# checkout of the lane's branch. A plain checkout ships its .git as before.
#
# rsync lists the files first and copies them after, so a commit made while
# a sync runs writes loose objects the list does not have while the ref the
# copy reads already names the new commit: the VM's HEAD then points at an
# object it never received, `git diff HEAD` there fails with "bad object
# HEAD", and bench/lib.sh's tree_dirty used to read that failure as a dirty
# tree (2026-09-20, the 3c6602b scorecard, tagged `+` on both VMs from a
# clean tree). After the copy the remote HEAD must be the local HEAD and its
# commit readable; a second pass copies what the first missed, and a
# mismatch after that fails the sync. A host without git (a Chainguard OS
# cell runs everything in podman) is not checked.
rsync_tree() {
  local ssh="$1" dest="$2" pass want got
  for pass in 1 2; do
    rsync_pass "$ssh" "$dest" || return 1
    want="$(git -C "$REPO" rev-parse HEAD)"
    got="$($ssh "$dest" "command -v git >/dev/null 2>&1 || { echo nogit; exit 0; }; cd $REMOTE_DIR && git cat-file -e 'HEAD^{commit}' 2>/dev/null && git rev-parse HEAD" 2>/dev/null || echo failed)"
    case "$got" in
      "$want") return 0 ;;
      nogit)   echo "challoc-bench: $dest has no git; the synced HEAD was not verified" >&2; return 0 ;;
    esac
    [ "$pass" = 1 ] && echo "challoc-bench: $dest: HEAD after the sync is '$got', local HEAD is $want (a commit during the sync?); syncing again" >&2
  done
  echo "challoc-bench: $dest: the synced tree's HEAD ($got) is not the local HEAD ($want) after two passes" >&2
  return 1
}
rsync_pass() {
  local ssh="$1" dest="$2" common wtdir
  local -a ex=(--exclude=/target --exclude=/.ralph --exclude='/.tmp-*' --exclude='/.ralph-*.log')
  if [ -f "$REPO/.git" ]; then
    common="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)"
    wtdir="$(git -C "$REPO" rev-parse --path-format=absolute --git-dir)"
    # --delete leaves excluded paths alone on the receiver, so the remote
    # .git survives the first pass and the second brings it up to date.
    rsync -az --delete "${ex[@]}" --exclude=/.git -e "$ssh" "$REPO/" "$dest:$REMOTE_DIR/" \
    && rsync -az --delete --exclude=/worktrees --exclude=/HEAD --exclude=/index --exclude=/ORIG_HEAD --exclude=/logs \
         -e "$ssh" "$common/" "$dest:$REMOTE_DIR/.git/" \
    && rsync -az -e "$ssh" "$wtdir/HEAD" "$wtdir/index" "$dest:$REMOTE_DIR/.git/"
  else
    rsync -az --delete "${ex[@]}" -e "$ssh" "$REPO/" "$dest:$REMOTE_DIR/"
  fi
}

# sync mirrors the working tree, uncommitted changes included, with --delete:
# anything the VM keeps under ~/challoc that is not in the tree (logs) is
# removed, so VM-side logs belong in ~/logs. It warns when src/ (or the
# crate manifest) has uncommitted changes, because the library `make
# quick`/`make ab` measure as "tree" on the VM is then not HEAD.
cmd_sync() {
  local dirty
  dirty="$(git -C "$REPO" status --porcelain -- src Cargo.toml Cargo.lock build.rs 2>/dev/null || true)"
  if [ -n "$dirty" ]; then
    echo "challoc-bench: WARNING: uncommitted changes in the library sources are being synced (the VM's working tree != HEAD $(git -C "$REPO" rev-parse --short HEAD)):" >&2
    echo "$dirty" | sed 's/^/    /' >&2
  fi
  # One rsync per target in parallel; the exit code is the worst of them.
  # (Before 2026-09-20 a failed rsync, say after a VM restart changed its
  # host key, returned 0 and the VM went on measuring its stale tree.)
  local -a pids=() names=()
  for t in $(targets "${1:-all}"); do
    local dest; dest="$(ssh_target "$t")"
    echo "challoc-bench: syncing $REPO -> $dest:$REMOTE_DIR"
    rsync_tree "$(ssh_cmd)" "$dest" &
    pids+=($!); names+=("$(vm_name "$t")")
  done
  local i failed=
  for i in "${!pids[@]}"; do wait "${pids[$i]}" || failed="$failed ${names[$i]}"; done
  [ -z "$failed" ] || die "sync FAILED for:$failed (host key changed after a restart? ssh-keygen -R <ip> -f ~/.ssh/google_compute_known_hosts; or the HEAD check above)"
}

cmd_run() {
  local t="$1"; shift
  [ $# -gt 0 ] || die "run needs a command"
  gssh "$t" --command="cd $REMOTE_DIR && $*" -- -T
}

cmd_make() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make $*"
}

# quoted ARGS...: each argument escaped for the remote (bash) shell, so
# VARIANTS='old=HEAD~1 new=HEAD' survives the ssh hop intact.
quoted() { local a out=; for a in "$@"; do out="$out $(printf '%q' "$a")"; done; echo "${out# }"; }

# quick / ab: sync, then the Makefile tier on the VM. Remaining arguments are
# VAR=value pairs for make (OLD=..., VARIANTS=..., ROUNDS=..., RESULT=...).
cmd_quick() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make quick $(quoted "$@")"
}
cmd_ab() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make ab $(quoted "$@")"
}

# quick-perf: the PERF=1 half of quick.sh with perf on the VM host. Sync,
# build old and new in the container (`make quick QUICK_BUILD_ONLY=1`, with
# OLD=/NEW= if given), then bench/gce/quick-perf.sh runs the rows detached
# and attaches `sudo perf stat --inherit -p` from the host; remaining
# arguments (ROWS=, VARIANTS=, EVENTS=, OUTDIR=) go to that script.
cmd_quick_perf() {
  local t="$1"; shift
  local a mk=() qp=()
  for a in "$@"; do case "$a" in OLD=*|NEW=*) mk+=("$a");; *) qp+=("$a");; esac; done
  cmd_sync "$t"
  cmd_run "$t" "make quick QUICK_BUILD_ONLY=1 $(quoted ${mk[@]+"${mk[@]}"})"
  cmd_run "$t" "bash bench/gce/quick-perf.sh $t $(quoted ${qp[@]+"${qp[@]}"})"
}

# scorecard: sync, `make scorecard` on the VM (bench/scorecard.sh appends
# one line to bench/results/scorecard-<arch>.md), then fetch the results
# directory back (fetch never overwrites a newer local file).
cmd_scorecard() {
  local t="$1"; shift
  cmd_sync "$t"
  cmd_run "$t" "make scorecard $(quoted "$@")"
  cmd_fetch "$t"
}

# pmu-check proves the PMU is real: every reference event must count
# non-zero on a short busy loop. Fails loudly if any reads <not supported>
# or 0.
cmd_pmu_check() {
  for t in $(targets "${1:-all}"); do
    echo "== $(vm_name "$t")"
    gssh "$t" --command="bash -s" -- -T <<REMOTE
set -euo pipefail
perf stat -x, -e $PMU_EVENTS -- sh -c 'i=0; while [ \$i -lt 300000 ]; do i=\$((i+1)); done' 2>&1 \
  | awk -F, '{ printf "%-28s %s\n", \$3, \$1; if (\$1 == "<not supported>" || \$1 == "<not counted>" || \$1 == 0) bad = 1 } END { exit bad }' \
  && echo "pmu ok: all events counted" || { echo "pmu FAIL: an event did not count"; exit 1; }
REMOTE
  done
}

# perf-stat runs a `docker run` command line (the Makefile's DOCKER_RUN
# shape, or any docker run) detached on the VM, finds the benchmark process
# inside it from the host, and attaches perf stat to it until it exits.
# Usage: perf-stat arm64 'make run CMD="LD_PRELOAD=... larson ..."' is NOT
# supported (make runs docker in the foreground); pass a docker run line:
#   perf-stat arm64 'docker run --rm -v \$PWD:/src -w /src -v challoc-target-arm64:/src/target challoc-dev:arm64 sh -c "LD_PRELOAD=/src/target/release/libchalloc.so target/bench-bin/larson 5 8 1000 5000 100 4141 10"'
cmd_perf_stat() {
  local t="$1"; shift
  [ $# -gt 0 ] || die "perf-stat needs a docker run command line"
  # Detach by inserting -d right after `docker run`: appended at the end it
  # would land inside the container's `sh -c` arguments.
  local cmd="$*"
  case "$cmd" in "docker run "*) cmd="docker run -d ${cmd#docker run }";; *) die "perf-stat needs a command line starting with 'docker run'";; esac
  gssh "$t" --command="bash -s" -- -T <<REMOTE
set -euo pipefail
cd $REMOTE_DIR
cid=\$($cmd 2>/dev/null || { echo "docker run failed" >&2; exit 1; })
# wait for the first process inside the container, then attach to the whole cgroup via its pids
for i in \$(seq 1 50); do pid=\$(docker inspect -f '{{.State.Pid}}' "\$cid" 2>/dev/null || true); [ -n "\$pid" ] && [ "\$pid" != 0 ] && break; sleep 0.1; done
[ -n "\$pid" ] || { echo "container did not start" >&2; exit 1; }
echo "== perf stat on container \$cid (init pid \$pid), events: $PMU_EVENTS"
# perf must run as root to attach to the container's root-owned process
# (EACCES otherwise, whatever perf_event_paranoid says); it is stopped by
# killing its sleep child, since SIGINT to perf is swallowed by the
# restarted wait4 when perf has no terminal.
sudo perf stat -e $PMU_EVENTS --inherit -p "\$pid" -o /tmp/challoc-perf-stat.txt -- sleep 1000000 &
pp=\$!
docker wait "\$cid" >/dev/null
sudo pkill -f '^sleep 1000000$' 2>/dev/null; wait \$pp || true
cat /tmp/challoc-perf-stat.txt
docker logs "\$cid" 2>&1 | tail -20
docker rm -f "\$cid" >/dev/null 2>&1 || true
REMOTE
}

cmd_fetch() {
  local t="$1" src; src="$(ssh_target "$t")"
  # --update: a file the VM has that is older than the local copy is skipped,
  # so a results file edited locally after the run is never clobbered.
  rsync -az --update -i -e "$(ssh_cmd)" \
    "$src:$REMOTE_DIR/bench/results/" "$REPO/bench/results/" | sed 's/^/challoc-bench: fetch /'
}

cmd_ssh()    { local t="$1"; shift; gssh "$t" "$@"; }
# status: this prefix's VMs when CHALLOC_GCE_PREFIX is set (a lane sees its
# own pair and matrix cells), every challoc-* VM in the project when it is
# not (the coordinator sees every lane).
cmd_status() {
  local filter="name~^challoc-"
  [ -z "${CHALLOC_GCE_PREFIX:-}" ] || filter="name~^$PREFIX-"
  g compute instances list --filter="$filter" \
    --format='table(name,zone.basename(),machineType.basename(),status,networkInterfaces[0].accessConfigs[0].natIP)'
}

# to_epoch RFC3339: epoch seconds for gcloud's timestamps
# (2026-09-19T10:11:12.345-07:00), GNU date first, then BSD date.
to_epoch() {
  local ts; ts="$(echo "$1" | sed -E -e 's/\.[0-9]+//' -e 's/Z$/+0000/' -e 's/([+-][0-9]{2}):([0-9]{2})$/\1\2/')"
  date -u -d "$ts" +%s 2>/dev/null || date -j -u -f '%Y-%m-%dT%H:%M:%S%z' "$ts" +%s 2>/dev/null || true
}

# lane_of NAME: the prefix that owns a VM: `<prefix>-matrix` for a matrix
# cell, else the name without its -arm64/-amd64 suffix.
lane_of() {
  case "$1" in
    *-matrix-*) echo "${1%%-matrix-*}-matrix" ;;
    *-arm64|*-amd64) echo "${1%-*}" ;;
    *) echo "$1" ;;
  esac
}

# lanes: every challoc-* instance in the project grouped by the prefix
# that owns it, with status, zone, machine type and, when running, the
# uptime since the last start. The coordinator's view across lanes.
cmd_lanes() {
  local now name status zone machine started lane up prev=
  now="$(date +%s)"
  g compute instances list --filter="name~^challoc-" \
    --format='value(name,status,zone.basename(),machineType.basename(),lastStartTimestamp)' \
  | while IFS="$(printf '\t')" read -r name status zone machine started; do
      [ -n "$name" ] || continue
      up=-
      if [ "$status" = RUNNING ] && [ -n "$started" ]; then
        local t0; t0="$(to_epoch "$started")"
        [ -n "$t0" ] && up="$(( (now - t0) / 3600 ))h$(( (now - t0) % 3600 / 60 ))m"
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(lane_of "$name")" "$name" "$status" "$zone" "$machine" "$up"
    done \
  | sort \
  | while IFS="$(printf '\t')" read -r lane name status zone machine up; do
      [ "$lane" = "$prev" ] || { [ -z "$prev" ] || echo; echo "== $lane"; prev="$lane"; }
      printf '   %-36s %-11s %-14s %-18s %s\n' "$name" "$status" "$zone" "$machine" "$up"
    done
  echo
  echo "challoc-bench: a lane's own view is CHALLOC_GCE_PREFIX=<lane> challoc-bench status; the reference pair (challoc-bench) is the coordinator's"
}
# start retries a few times: a zone can report ZONE_RESOURCE_POOL_EXHAUSTED for
# a minute or two and then admit the same instance.
start_one() {
  local name="$1" i
  for i in 1 2 3 4; do
    g compute instances start "$name" --zone="$ZONE" && return 0
    echo "challoc-bench: start of $name failed (attempt $i), retrying in 60 s" >&2
    sleep 60
  done
  g compute instances start "$name" --zone="$ZONE"
}
do_start()   { for t in $(targets "${1:-all}"); do start_one "$(vm_name "$t")" & done; wait; }
do_stop()    { for t in $(targets "${1:-all}"); do g compute instances stop   "$(vm_name "$t")" --zone="$ZONE" & done; wait; }
cmd_delete() { for t in $(targets "${1:-all}"); do g compute instances delete "$(vm_name "$t")" --zone="$ZONE" --quiet & done; wait; }
# start/stop defer to the session driver while CHALLOC_GCE_WARM is set.
warm() { [ -n "${CHALLOC_GCE_WARM:-}" ]; }
cmd_start() { if warm; then echo "challoc-bench: CHALLOC_GCE_WARM is set; the session driver owns the VMs, not starting (they should already be up: 'status')"; else do_start "$@"; fi; }
cmd_stop()  { if warm; then echo "challoc-bench: CHALLOC_GCE_WARM is set; the session driver owns the VMs, not stopping (use 'session stop' at the end of the session)"; else do_stop "$@"; fi; }
cmd_session() {
  local what="${1:-}"; shift || true
  case "$what" in
    start) do_start "$@"; echo "challoc-bench: session VMs are up; export CHALLOC_GCE_WARM=1 for the iterations, and run 'challoc-bench session stop' once at the end" ;;
    stop)  do_stop "$@"; echo "challoc-bench: session VMs stopped" ;;
    *) die "session needs start or stop" ;;
  esac
}

# ---------------------------------------------------------------------------
# matrix: the floor, proven (docs/plan.md Phase 2.5 task 3). For each cell
# (a kernel: image family or a kernel package installed on top of one,
# architecture, machine type) create a throwaway VM `challoc-matrix-<cell>`,
# provision Docker (the `provision` steps minus perf), sync the tree, run
# bench/gce/matrix-cell.sh detached on it (make image, make test, the probe
# line, make fuzz, make test-cgroup, plus the --privileged make test where
# the cell asks for it), fetch ~/logs into bench/results/matrix/<date>-<cell>.log
# and DELETE the VM, passed or failed, timed out or interrupted. Cells run
# MATRIX_JOBS (3) at a time with MATRIX_TIMEOUT (2700 s) each; the driver's
# exit trap deletes every challoc-matrix-* VM in the zone, and `matrix clean`
# does the same by hand. Nothing here measures anything: the machines are
# small and the numbers in the logs are not benchmark numbers.
#
#   challoc-bench matrix                 # every cell of the table below
#   challoc-bench matrix k510-amd64 64k-arm64
#   challoc-bench matrix list            # the table
#   challoc-bench matrix clean           # delete every challoc-matrix-* VM
#   challoc-bench matrix lab 64k-arm64   # create+prep+provision+sync, keep the VM
#   challoc-bench matrix ssh 64k-arm64 'make test-cgroup-oscillate OSC_SECS=60'
#   challoc-bench matrix sync 64k-arm64  # rsync the tree again
#
# `lab` runs a cell up to the sync and keeps the VM (its log goes to
# .tmp-matrix-lab/, not bench/results/matrix/); `ssh` and `sync` drive it;
# `clean` deletes it like any other matrix VM. Nothing measured on a lab
# VM is a benchmark number either. MATRIX_PMU=1 creates the VM with
# --performance-monitoring-unit=standard (C3, C3D, C4, C4A, N4 take it;
# T2A, C2 and N2D refuse it: "Invalid performance monitoring unit"), so a
# lab cell can attribute a row with perf stat (bench/gce/quick-perf.sh
# after linux-tools-$(uname -r) is installed on it). MATRIX_MACHINE=<type>
# replaces the cell's machine type (lab or not): the Valkey soak at 64 KiB
# pages (plan Phase 2.5 task 4d) ran on `MATRIX_MACHINE=c4a-standard-16
# MATRIX_PMU=1 matrix lab 64k-arm64`, the reference VMs' shape.
#
# The CPU matrix (task 4): the cpu-* cells run the same Ubuntu 24.04 image
# and its GCE kernel on one machine type each, so only the CPU varies, and
# the cell script's `scorecard` flag replaces fuzz and test-cgroup with one
# `make scorecard ROUNDS=3` (challoc vs jemalloc, the fixed row set) written
# to bench/results/scorecard-<family>.md on the VM and fetched back next to
# the two reference files (scorecard-aarch64.md, scorecard-x86_64.md, which
# stay the acceptance record and are not touched). Families live in
# different zones (T2A only in us-central1), so a cell names its zones:
# a comma-separated list tried in order, at most two, for capacity or quota
# errors (ZONE_RESOURCE_POOL_EXHAUSTED, QUOTA_EXCEEDED); `-` is $ZONE. The
# -standard-8 shapes are enough for a feature report and a 3-round
# scorecard; the reference files are 16 vCPU, so a cpu-* scorecard is
# compared with the reference CPU of its architecture row by row
# (challoc-vs-jemalloc percentages), never by absolute throughput.
#
#   challoc-bench matrix cpu             # every cpu-* cell
#   challoc-bench matrix cpu-c3d cpu-t2a
#
# The table. `prep` installs another kernel on the image and reboots into
# it (ga: linux-generic, Ubuntu 24.04's 6.8 GA kernel, because the GCE
# image itself boots the 7.0 linux-gcp kernel since 2026; hwe:
# linux-generic-hwe-24.04, the 6.13+ non-GCE kernel, 7.0.0-31-generic in
# 2026-09; 64k: linux-generic-64k, the 6.8 GA kernel with 64 KiB pages);
# `extra` adds the privileged run: on k68-amd64 for a 6.8 host (where
# process_madvise with MADV_DONTNEED does not exist yet, whatever seccomp
# says) and on hwe-amd64, where the batch purge path and mseal light for
# real on a non-GCE kernel. The gcp-* cells run the image's own
# kernel, 7.0.0-1011-gcp, the reference VMs' kernel, on the small machines.
# Matrix VMs follow the lane prefix (challoc-lane-b-matrix-<cell>), so one
# lane's `matrix clean` cannot delete another's cells; the default prefix
# keeps the historical challoc-matrix-<cell>.
#
# The Chainguard OS cells (task 14, 2026-09-19): cgos-arm64 and cgos-amd64
# boot the product's own image (`kirkland-server-hypervisor-<arch>` in the
# `wolfi-vm` project, docs/runbooks/chainguard-os-gce.md: kernel 6.18,
# glibc 2.44 on the host, bootc/composefs with a read-only fs-verity root)
# on the reference shapes c4a-standard-8 / c4-standard-8, the first "floor
# as shipped" cells (cgos72-amd64, 2026-09-20, is the same cell on the
# kernel 7.2 workstation image, x86_64 only; see the cell table) and the only ones without Docker's seccomp profile
# between the library and the kernel. A bootc host has no apt, no apk on
# the host, no Docker, no make, no getconf, no perf; rootless podman fails
# (/run/containers/storage is root's) and netavark has no `nft`, so the
# provisioning (matrix_provision_bootc_script) grows /var (OS-3363: the
# image ships without resize2fs, the ext4 root stays at 4.9 GiB; resize2fs
# from a wolfi-base container seeing the mount does the online grow),
# installs a `docker` shim in ~/bin that runs `sudo podman` with
# `--network=host`, copies `make` and `getconf` out of a Wolfi container
# (the host glibc is the same 2.44, so they run natively), and the cell
# script's `cgos` mode (bench/gce/matrix-cell.sh) runs the tests inside
# podman with the default seccomp profile and with --privileged, the probe
# line three ways (podman, podman --privileged, natively on the host with
# LD_PRELOAD), the host capture (config.gz keys, THP, glibc) and one
# scorecard run into bench/results/scorecard-cgos-<arch>.md. Login is the
# gcloud user through the project's ssh-keys metadata (OS Login is not
# assumed on this image). `MATRIX_ADOPT=<vm-name>` runs a cell on a VM that
# already exists (any zone), skipping create and never deleting it: the
# lane's coordinator-created pair, or a `matrix lab` VM kept from before.
if [ "$PREFIX" = challoc-bench ]; then
  MATRIX_PREFIX="${CHALLOC_MATRIX_PREFIX:-challoc-matrix}"
else
  MATRIX_PREFIX="${CHALLOC_MATRIX_PREFIX:-$PREFIX-matrix}"
fi
MATRIX_JOBS="${MATRIX_JOBS:-3}"
MATRIX_TIMEOUT="${MATRIX_TIMEOUT:-2700}"
MATRIX_DATE="${MATRIX_DATE:-$(date +%F)}"
MATRIX_OUT="${MATRIX_OUT:-$REPO/bench/results/matrix}"
MATRIX_CELLS="k510-amd64 k61-amd64 k61-arm64 k68-amd64 k68-arm64 hwe-amd64 64k-arm64 gcp-amd64 gcp-arm64"
# The CPU cells (task 4), 2026-09-19: one -standard-8 per family. Zones from
# `gcloud compute machine-types list --filter="name~'-standard-8$'"`: every
# family in us-east4-a except T2A (us-central1-a,b,f only).
MATRIX_CPU_CELLS="cpu-c4a cpu-t2a cpu-c4 cpu-c3 cpu-c3d cpu-n2d cpu-c2 cpu-n4"
# The Chainguard OS cells (task 14): the product's image on the reference
# shapes, us-east4-a (the image families are in the wolfi-vm project), plus
# the kernel 7.2 workstation image on the x86_64 shape (2026-09-20): all
# three run concurrently under MATRIX_JOBS=3, so `matrix cgos` costs the
# same wall time with or without the third cell.
MATRIX_CGOS_CELLS="cgos-arm64 cgos-amd64 cgos72-amd64"

# cell_spec CELL -> "family project arch machine prep extra zones"
# (extra: none | privileged | scorecard | cgos; zones: comma-separated, `-` = $ZONE)
cell_spec() {
  case "$1" in
    # Chainguard OS (bootc, podman): the runbook's image families.
    cgos-arm64) echo "kirkland-server-hypervisor-arm64 wolfi-vm arm64 c4a-standard-8 none cgos us-east4-a" ;;  # Axion, kernel 6.18, glibc 2.44
    cgos-amd64) echo "kirkland-server-hypervisor-amd64 wolfi-vm amd64 c4-standard-8 none cgos us-east4-a" ;;   # Xeon 8581C, the same image for x86_64
    # Kernel 7.2 (2026-09-20): the workstation image family, x86_64 only
    # (kirkland-workstation-7dot2-amd64-20260920-0028, created 2026-09-20
    # 00:50 UTC; the metal twin is kirkland-workstation-7dot2-metal-amd64,
    # not a cell). A copy of cgos-amd64 with the family swapped: the first
    # host newer than GCE's Ubuntu 7.0, for the 7.2 rows of docs/research.md
    # (khugepaged anon mTHP collapse, cache-aware scheduling,
    # CONFIG_RSEQ_SLICE_EXTENSION). Its scorecard file is
    # scorecard-cgos72-amd64.md (the cell name's prefix), never the 6.18 one.
    cgos72-amd64) echo "kirkland-workstation-7dot2-amd64 wolfi-vm amd64 c4-standard-8 none cgos us-east4-a" ;;  # Xeon 8581C, kernel 7.2
    k510-amd64) echo "debian-11 debian-cloud amd64 e2-standard-4 none none -" ;;
    k61-amd64)  echo "debian-12 debian-cloud amd64 e2-standard-4 none none -" ;;
    k61-arm64)  echo "debian-12-arm64 debian-cloud arm64 c4a-standard-4 none none -" ;;
    k68-amd64)  echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3-standard-4 ga privileged -" ;;
    k68-arm64)  echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 c4a-standard-4 ga none -" ;;
    gcp-amd64)  echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3-standard-4 none none -" ;;
    gcp-arm64)  echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 c4a-standard-4 none none -" ;;
    hwe-amd64)  echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3-standard-4 hwe privileged -" ;;
    64k-arm64)  echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 c4a-standard-4 64k none -" ;;
    # The CPU matrix: Ubuntu 24.04 and its GCE kernel everywhere.
    cpu-c4a)    echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 c4a-standard-8 none scorecard us-east4-a,us-east4-b" ;;    # Google Axion, Neoverse V2 (reference)
    cpu-t2a)    echo "ubuntu-2404-lts-arm64 ubuntu-os-cloud arm64 t2a-standard-8 none scorecard us-central1-a,us-central1-b" ;; # Ampere Altra, Neoverse N1
    cpu-c4)     echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c4-standard-8 none scorecard us-east4-a,us-east4-b" ;;     # Xeon 8581C, Emerald Rapids (reference)
    cpu-c3)     echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3-standard-8 none scorecard us-east4-a,us-east4-b" ;;     # Sapphire Rapids
    cpu-c3d)    echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c3d-standard-8 none scorecard us-east4-a,us-east4-b" ;;    # AMD Genoa, Zen 4
    cpu-n2d)    echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 n2d-standard-8 none scorecard us-east4-a,us-east4-b" ;;    # AMD Milan or Rome, whichever the zone gives
    cpu-c2)     echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 c2-standard-8 none scorecard us-east4-a,us-east4-b" ;;     # Cascade Lake
    cpu-n4)     echo "ubuntu-2404-lts-amd64 ubuntu-os-cloud amd64 n4-standard-8 none scorecard us-east4-a,us-east4-b" ;;     # Emerald Rapids on the N4 platform (optional)
    *) return 1 ;;
  esac
}

# cell_zones CELL: the zone list as words, `-` resolved to $ZONE.
cell_zones() {
  local z; z="$(cell_spec "$1" | awk '{ print $7 }')"
  [ "$z" != - ] && [ -n "$z" ] || z="$ZONE"
  echo "$z" | tr ',' ' '
}

# latest_image FAMILY PROJECT: the family's current image, or, for a
# deprecated family (debian-11 since 2026), the newest deprecated image
# that is still READY. Prints the image name.
latest_image() {
  local fam="$1" proj="$2" name
  name="$(g compute images describe-from-family "$fam" --project="$proj" --format='value(name)' 2>/dev/null || true)"
  if [ -z "$name" ]; then
    name="$(g compute images list --project="$proj" --show-deprecated --filter="family=$fam AND status=READY" --format='value(name)' 2>/dev/null | sort | tail -1)"
  fi
  [ -n "$name" ] || return 1
  echo "$name"
}

matrix_vm() { echo "$MATRIX_PREFIX-$1"; }

# matrix_ssh CELL_IP_USER CMD...: direct ssh with the minted key. Matrix VMs
# are throwaway and GCE hands a deleted VM's external IP to the next one
# within minutes, so no host key is kept at all: `accept-new` with a
# known_hosts file rejected the recycled IPs' new keys and the cells sat
# in `matrix_wait_ssh` until their deadline.
matrix_ssh_opts() {
  echo "-i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=6 -o LogLevel=ERROR"
}
matrix_ssh() { # matrix_ssh user@ip CMD...
  local dest="$1"; shift
  # shellcheck disable=SC2046
  ssh -T $(matrix_ssh_opts) "$dest" "$@"
}

# matrix_wait_ssh user@ip DEADLINE: until `true` runs on the VM or the
# deadline (epoch seconds) passes.
matrix_wait_ssh() {
  local dest="$1" deadline="$2"
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if matrix_ssh "$dest" true 2>/dev/null; then return 0; fi
    sleep 10
  done
  return 1
}

# matrix_delete_vm VM [ZONE...]: delete the VM from each zone named (default
# $ZONE) where it exists, twice before giving up.
matrix_delete_vm() {
  local vm="$1" z; shift
  [ $# -gt 0 ] || set -- "$ZONE"
  for z in "$@"; do
    if g compute instances describe "$vm" --zone="$z" >/dev/null 2>&1; then
      g compute instances delete "$vm" --zone="$z" --quiet >/dev/null 2>&1 \
        || g compute instances delete "$vm" --zone="$z" --quiet >/dev/null 2>&1 \
        || echo "challoc-bench: matrix: WARNING: could not delete $vm in $z; delete it by hand" >&2
    fi
  done
}

# matrix_vm_zone VM: the zone the VM exists in (any zone), or nothing.
matrix_vm_zone() {
  g compute instances list --filter="name=$1" --format='value(zone.basename())' 2>/dev/null | head -1
}

# matrix_oslogin FAM EXTRA: 0 when a cell on image family FAM logs in
# through OS Login (the VM is created with enable-oslogin=TRUE and the OS
# Login posix user logs in with sudo and the docker group). That is every
# cell except a Chainguard OS server image (kirkland-server-hypervisor-*,
# `cgos` cells): a bootc server host takes no OS Login, and the login user
# is the gcloud user, whose key the project's ssh-keys metadata carries
# (CHALLOC_GCE_USER, default $USER). The workstation images
# (kirkland-workstation-*, the kernel 7.2 cell) are the other way round
# (2026-09-20): their guest agent creates no user from ssh-keys metadata,
# and OS Login works. (Lane E, 2026-09-20: `matrix ssh cgos-arm64` used to
# try the OS Login user on the server image and was refused.)
matrix_oslogin() {
  [ "$2" = cgos ] || return 0
  case "$1" in kirkland-workstation-*) return 0 ;; *) return 1 ;; esac
}
# matrix_user FAM EXTRA: the login user of a cell VM, per matrix_oslogin.
matrix_user() {
  if matrix_oslogin "$1" "$2"; then
    g compute os-login describe-profile --format='value(posixAccounts[0].username)'
  else
    echo "${CHALLOC_GCE_USER:-$USER}"
  fi
}

# matrix_lab_dest CELL: user@ip of a kept (lab) cell VM, the user the one
# matrix_cell logged in as (matrix_user).
matrix_lab_dest() {
  local vm ip user z fam extra
  vm="$(matrix_vm "$1")"
  z="$(matrix_vm_zone "$vm")"; [ -n "$z" ] || die "matrix: no VM $vm (matrix lab $1 creates one)"
  ip="$(g compute instances describe "$vm" --zone="$z" --format='value(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null)" \
    || die "matrix: no VM $vm (matrix lab $1 creates one)"
  [ -n "$ip" ] || die "matrix: $vm has no external IP"
  read -r fam _ _ _ _ extra _ <<<"$(cell_spec "$1")"
  user="$(matrix_user "$fam" "$extra")"
  echo "$user@$ip"
}

# matrix_fail REASON [KERNEL [PAGE [OUTCOME]]]: the cell's summary line when
# the driver gives up before matrix-cell.sh writes its own (that one carries
# the measured fields: tests, fuzz, cgroup, privileged, scorecard). The
# summary of cmd_matrix and the results file read the last `MATRIX ` line
# of the cell's log, so every exit path writes the same field set, the
# unmeasured fields `-`, outcome FAIL unless given (PENDING: no zone had
# capacity) and a reason. Uses matrix_cell's cell, image, fam, machine, t0
# and log (bash's dynamic scope; it is only called from there).
matrix_fail() {
  echo "MATRIX cell=$cell image=${image:-none/$fam} kernel=${2:--} page=${3:--} machine=$machine tests=- fuzz=- cgroup=- privileged=- scorecard=- wall=$(( $(date +%s) - t0 )) outcome=${4:-FAIL} reason=$1" >> "$log"
}

# matrix_prep PREP: the remote script that installs the cell's kernel,
# points GRUB at it by title (the GCE kernel's version string sorts above
# the generic one, so the default entry alone would not do) and reboots.
matrix_prep_script() {
  case "$1" in
    ga)  echo 'pkg=linux-generic; pat=generic' ;;
    hwe) echo 'pkg=linux-generic-hwe-24.04; pat=generic' ;;
    64k) echo 'pkg=linux-generic-64k; pat=generic-64k' ;;
    *) return 1 ;;
  esac
  cat <<'PREP'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -qq
sudo apt-get install -y -qq "$pkg" >/dev/null
kver="$(ls /boot/vmlinuz-*-"$pat" | sed 's#.*/vmlinuz-##' | sort -V | tail -1)"
[ -n "$kver" ] || { echo "no $pat kernel installed"; exit 1; }
echo "== installed $kver"
# GCE's Ubuntu images boot without an initrd (40-force-partuuid.cfg): only
# the gcp kernel has the NVMe/virtio drivers built in, a generic kernel
# panics with "Unable to mount root fs". Clearing GRUB_FORCE_PARTUUID
# brings the initrd back.
printf 'GRUB_DEFAULT="Advanced options for Ubuntu>Ubuntu, with Linux %s"\nGRUB_FORCE_PARTUUID=\n' "$kver" \
  | sudo tee /etc/default/grub.d/99-challoc-matrix.cfg >/dev/null
sudo update-grub >/dev/null 2>&1
sudo grep -q "with Linux $kver" /boot/grub/grub.cfg || { echo "grub.cfg has no entry for $kver"; exit 1; }
sudo grep -q "initrd.*initrd.img-$kver" /boot/grub/grub.cfg || { echo "grub.cfg has no initrd line for $kver"; exit 1; }
echo "== rebooting into $kver"
(sleep 1; sudo systemctl reboot) >/dev/null 2>&1 </dev/null &
PREP
}

# The provision steps of cmd_provision minus perf (Debian has no
# linux-tools for its cloud kernel, and the cells measure nothing).
matrix_provision_script() {
  cat <<'REMOTE'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
if grep -q bullseye /etc/os-release; then
  # bullseye's LTS ended on 2026-08-31: its security suite's pool is gone
  # (404 on every package the image's lists name), so the cell installs
  # from main alone; if main leaves deb.debian.org too, the archive.
  echo "== bullseye: dropping the security and updates suites"
  sudo sed -i -e '/-security/d' -e '/bullseye-updates/d' -e '/backports/d' /etc/apt/sources.list
  sudo rm -f /etc/apt/sources.list.d/*security*.list
fi
if ! sudo apt-get update -qq; then
  echo "== apt-get update failed; switching to archive.debian.org"
  sudo sed -i 's#deb.debian.org/debian#archive.debian.org/debian#g' /etc/apt/sources.list
  sudo apt-get -o Acquire::Check-Valid-Until=false update -qq
fi
sudo apt-get install -y -qq docker.io make rsync jq curl >/dev/null
# git is optional on the host (the container has its own): on bullseye
# main's perl no longer matches the image's perl-base from the closed
# security suite, so git is not installable there.
sudo apt-get install -y -qq git >/dev/null 2>&1 || echo "== git not installable on this image (fine)"
sudo usermod -aG docker "$USER"
if ! grep -q '"mtu": 1460' /etc/docker/daemon.json 2>/dev/null; then
  echo '{ "mtu": 1460 }' | sudo tee /etc/docker/daemon.json >/dev/null
  sudo systemctl restart docker
fi
sudo systemctl enable --now docker >/dev/null
# The negative tests abort on purpose. Debian's core_pattern is `core` in
# the process's cwd, which for the container is the bind-mounted tree: a
# root-owned `core` there breaks every later `docker build` ("no permission
# to read from .../core"). Ubuntu pipes cores to apport. Discard them.
# Set the one key, not `sysctl --system`: that re-applies GCE's
# 60-gce-network-security.conf (net.ipv4.ip_forward = 0) over the value
# Docker set at start, and containers lose their networking.
echo 'kernel.core_pattern = |/bin/false' | sudo tee /etc/sysctl.d/90-challoc-matrix.conf >/dev/null
sudo sysctl -q -w 'kernel.core_pattern=|/bin/false' net.ipv4.ip_forward=1
mkdir -p ~/logs
echo "== $(hostname): $(uname -m) $(uname -r), page $(getconf PAGESIZE), $(. /etc/os-release; echo "$PRETTY_NAME")"
echo "== docker: $(sudo docker --version)"
REMOTE
}

# The bootc (Chainguard OS) provisioning, task 14: nothing is installed on
# the host (no apt, no apk; /usr is a read-only composefs). Everything the
# cell needs on the host side comes out of a Wolfi container or is a shell
# shim, in ~/bin, which matrix-cell.sh puts first on PATH. Idempotent.
matrix_provision_bootc_script() {
  cat <<'REMOTE'
set -euo pipefail
echo "== $(hostname): $(uname -m) $(uname -r), $(. /etc/os-release; echo "$PRETTY_NAME"), root $(findmnt -no FSTYPE,OPTIONS / | cut -c1-60)"
command -v podman >/dev/null || { echo "no podman on this host"; exit 1; }
# Rootless podman fails on this image (/run/containers/storage: permission
# denied), root podman works; every call below is `sudo podman`.
sudo podman info --format '{{.Host.CgroupsVersion}} {{.Host.Security.SECCOMPEnabled}} {{.Host.Security.SECCOMPProfilePath}} {{.Store.GraphRoot}}' | sed 's/^/== podman: cgroup /'
# OS-3363: the image's first-boot growfs never ran (no resize2fs on the
# host), so /var (with /home) is a 4.9 GiB ext4 on a 49 GiB partition; the
# dev image plus a target volume with the bench and Ruby builds need about
# 15 GiB. resize2fs from a container that sees the mount (-v /var) grows
# the mounted filesystem online.
dev="$(findmnt -no SOURCE /var | sed 's/\[.*//')"
avail_g="$(df -BG --output=avail /var | tail -1 | tr -dc 0-9)"
if [ "${avail_g:-0}" -lt 20 ]; then
  echo "== growing $dev online (/var has ${avail_g} GiB free)"
  sudo podman run --rm --privileged --network=host -v /dev:/dev -v /var:/mnt/var cgr.dev/chainguard/wolfi-base \
    sh -c "apk add --no-cache e2fsprogs-extra >/dev/null 2>&1; resize2fs $dev" 2>&1 | sed 's/^/   | /'
fi
df -h /var | sed 's/^/== /'
mkdir -p ~/bin ~/logs ~/native
# `docker` -> `sudo podman` with the host's network namespace: netavark
# needs `nft`, which the host lacks, so the default bridge network cannot be
# created ("unable to execute nft"); the host network also sidesteps the
# 1460-byte GCE MTU that Docker needed configuring for.
cat > ~/bin/docker <<'SHIM'
#!/bin/sh
# challoc matrix, Chainguard OS cell: the Makefile speaks docker; this host
# has root podman only, and no nft for netavark, so containers share the
# host's network namespace (bench/gce/challoc-bench, matrix_provision_bootc_script).
cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  run|build) exec sudo podman "$cmd" --network=host "$@" ;;
  *)         exec sudo podman "$cmd" "$@" ;;
esac
SHIM
chmod +x ~/bin/docker
# make and getconf out of a Wolfi container: the host glibc is Wolfi's
# 2.44, so they run natively.
if [ ! -x ~/bin/make ] || [ ! -x ~/bin/getconf ]; then
  sudo podman run --rm --network=host -v "$HOME/bin:/out" cgr.dev/chainguard/wolfi-base \
    sh -c 'apk add --no-cache make posix-libc-utils >/dev/null 2>&1 || apk add --no-cache make posix-libc-utils-2.44 >/dev/null; cp /usr/bin/make /usr/bin/getconf /out/'
  sudo chown "$USER" ~/bin/make ~/bin/getconf
fi
export PATH="$HOME/bin:$PATH"
echo "== make: $(make --version | head -1); getconf PAGESIZE: $(getconf PAGESIZE); docker shim: $(docker --version)"
# The negative tests abort on purpose; discard cores (a root-owned core in
# the bind-mounted tree breaks the next build's context).
sudo sysctl -q -w 'kernel.core_pattern=|/bin/false' || true
echo "== glibc: $(/usr/lib/libc.so.6 2>/dev/null | head -1)"
echo "== thp: $(cat /sys/kernel/mm/transparent_hugepage/enabled), perf_event_paranoid $(cat /proc/sys/kernel/perf_event_paranoid)"
REMOTE
}

# matrix_cell CELL: one cell start to finish, in a subshell of its own, its
# VM deleted on every exit path. Writes $MATRIX_OUT/$MATRIX_DATE-$CELL.log.
# MATRIX_ADOPT=<vm>: run the cell on that existing VM instead (any zone);
# it is provisioned and synced like a new one and never deleted.
matrix_cell() {
  # cell, vm and log are deliberately not local: the EXIT trap below runs
  # when the cell's subshell exits, after this function has returned and
  # its locals are gone.
  cell="$1"
  local spec fam proj arch machine prep extra zones image disk dest user ip t0 deadline rc summary z err
  log="$MATRIX_OUT/$MATRIX_DATE-$cell.log"
  spec="$(cell_spec "$cell")" || die "matrix: unknown cell $cell (matrix list)"
  read -r fam proj arch machine prep extra zones <<<"$spec"
  # MATRIX_MACHINE overrides the cell's machine type (a lab cell that must
  # carry a soak: `MATRIX_MACHINE=c4a-standard-16 matrix lab 64k-arm64`).
  [ -z "${MATRIX_MACHINE:-}" ] || machine="$MATRIX_MACHINE"
  # shellcheck disable=SC2034
  zones="$(cell_zones "$cell")"
  vm="$(matrix_vm "$cell")"
  local adopt="${MATRIX_ADOPT:-}"
  [ -z "$adopt" ] || vm="$adopt"
  t0=$(date +%s); deadline=$((t0 + MATRIX_TIMEOUT))
  mkdir -p "$MATRIX_OUT"
  : > "$log"
  say() { echo "[driver $(date -u +%H:%M:%S)] $*" | tee -a "$log"; }
  # Whatever happens below, the VM goes (from every zone the cell may use);
  # an adopted VM belongs to whoever created it and stays.
  # shellcheck disable=SC2064
  if [ -z "$adopt" ]; then
    trap "say \"deleting $vm\"; matrix_delete_vm $vm $zones; say \"deleted $vm\"" EXIT
  else
    trap "say \"adopted $vm stays (MATRIX_ADOPT)\"" EXIT
  fi
  trap 'say "signal: cell $cell interrupted"; exit 130' INT TERM HUP

  # OS Login or the gcloud user from the ssh-keys metadata (matrix_oslogin):
  # decides the create flag and the login user below.
  local oslogin=
  ! matrix_oslogin "$fam" "$extra" || oslogin=1
  # getconf is absent on a bootc host; the page size from smaps then.
  local pagesz='$(getconf PAGESIZE 2>/dev/null || awk "/^KernelPageSize/ { print \$2 * 1024; exit }" /proc/self/smaps)'

  image="$(latest_image "$fam" "$proj")" || { say "no READY image in family $fam ($proj)"; matrix_fail no-image; return 1; }
  # Hyperdisk Balanced is the only disk C4, C4A and N4 take; C2, N2D, T2A,
  # E2 and N2 take Persistent Disk only (C3 and C3D take both).
  case "$machine" in e2-*|n1-*|n2-*|n2d-*|c2-*|t2a-*) disk=pd-balanced ;; *) disk=hyperdisk-balanced ;; esac
  say "cell $cell: image $image ($fam, $proj), $arch, $machine, prep $prep, extra $extra, zones $zones, timeout ${MATRIX_TIMEOUT}s${adopt:+, adopting $adopt}"
  cell_zone=
  if [ -n "$adopt" ]; then
    cell_zone="$(matrix_vm_zone "$vm")"
    [ -n "$cell_zone" ] || { say "MATRIX_ADOPT: no VM named $vm exists"; matrix_fail adopt:no-such-vm; return 1; }
    machine="$(g compute instances describe "$vm" --zone="$cell_zone" --format='value(machineType.basename())')"
    local bootdisk; bootdisk="$(g compute instances describe "$vm" --zone="$cell_zone" --format='value(disks[0].source.basename())')"
    image="$(g compute disks describe "$bootdisk" --zone="$cell_zone" --format='value(sourceImage.basename())' 2>/dev/null || echo unknown)"
    say "adopting $vm in $cell_zone ($machine, boot image ${image:-unknown})"
  else
  # shellcheck disable=SC2086
  matrix_delete_vm "$vm" $zones
  # One attempt per zone of the list (at most two zones): a zone out of
  # capacity or quota for the family is recorded and the next one tried.
  for z in $zones; do
    # shellcheck disable=SC2086
    if g compute instances create "$vm" --zone="$z" --machine-type="$machine" \
          --image="$image" --image-project="$proj" \
          --boot-disk-size=50GB --boot-disk-type="$disk" ${MATRIX_PMU:+--performance-monitoring-unit=standard} \
          ${oslogin:+--metadata=enable-oslogin=TRUE} --scopes=cloud-platform \
          --labels="owner=${USER},purpose=challoc-matrix,arch=$arch,cell=$cell" >>"$log" 2>&1; then
      cell_zone="$z"; break
    fi
    err="$(grep -o -m1 -E 'ZONE_RESOURCE_POOL_EXHAUSTED[^ ]*|QUOTA_EXCEEDED|Quota [^.]*exceeded[^.]*|does not exist in zone[^.]*|[A-Z_]{8,}' "$log" | tail -1)"
    say "create failed for $vm in $z: ${err:-see the log}"
    matrix_delete_vm "$vm" "$z"
  done
  if [ -z "$cell_zone" ]; then
    # The zones tried are in the `cell ...: zones` line above.
    matrix_fail "create:${err:-unknown}" - - PENDING; return 1
  fi
  say "created $vm in $cell_zone"
  fi
  ip="$(g compute instances describe "$vm" --zone="$cell_zone" --format='value(networkInterfaces[0].accessConfigs[0].natIP)')"
  user="$(matrix_user "$fam" "$extra")"
  dest="$user@$ip"
  say "$vm at $ip; waiting for ssh as $user"
  if ! matrix_wait_ssh "$dest" "$deadline"; then say "ssh never came up"; matrix_fail no-ssh; return 1; fi
  say "up: $(matrix_ssh "$dest" "echo \"\$(uname -m) \$(uname -r) page $pagesz\"" 2>&1)"

  if [ "$prep" != none ]; then
    local boot0 boot1=
    boot0="$(matrix_ssh "$dest" cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
    say "prep $prep: installing the kernel and rebooting (boot id $boot0)"
    matrix_prep_script "$prep" | matrix_ssh "$dest" bash -s >>"$log" 2>&1 || { say "prep failed"; matrix_fail prep "$(matrix_ssh "$dest" uname -r 2>/dev/null)"; return 1; }
    # ssh keeps answering for a while after the reboot is issued: wait for
    # a new boot id, not merely for a connection.
    while [ "$(date +%s)" -lt "$deadline" ]; do
      sleep 10
      boot1="$(matrix_ssh "$dest" cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
      [ -n "$boot1" ] && [ "$boot1" != "$boot0" ] && break
      boot1=
    done
    if [ -z "$boot1" ]; then say "the VM did not come back with a new boot id after the reboot"; matrix_fail reboot; return 1; fi
    local kp; kp="$(matrix_ssh "$dest" 'echo "$(uname -r) $(getconf PAGESIZE)"' 2>/dev/null || true)"
    say "after reboot: $kp"
    case "$prep:$kp" in
      64k:6.8.*-generic-64k\ 65536) ;;
      ga:6.8.*-generic\ 4096) ;;
      hwe:6.8.*) say "the hwe kernel is still 6.8 (got: $kp)"; matrix_fail wrong-kernel "${kp% *}" "${kp##* }"; return 1 ;;
      hwe:*-generic\ 4096) ;;
      *) say "the VM did not boot the $prep kernel (got: $kp)"; matrix_fail wrong-kernel "${kp% *}" "${kp##* }"; return 1 ;;
    esac
  fi

  say "provisioning${extra:+ ($extra)}"
  local provision=matrix_provision_script
  [ "$extra" != cgos ] || provision=matrix_provision_bootc_script
  $provision | matrix_ssh "$dest" bash -s >>"$log" 2>&1 || { say "provision failed"; matrix_fail provision "$(matrix_ssh "$dest" uname -r 2>/dev/null)"; return 1; }
  say "syncing the tree"
  rsync_tree "ssh $(matrix_ssh_opts)" "$dest" >>"$log" 2>&1 || { say "sync failed"; matrix_fail sync; return 1; }
  if [ -n "${MATRIX_LAB:-}" ]; then
    # Lab mode: the VM stays. `matrix clean` deletes it.
    trap - EXIT
    say "lab: $vm kept at $dest; matrix ssh $cell CMD, matrix sync $cell, matrix clean"
    echo "LAB cell=$cell vm=$vm dest=$dest" >> "$log"
    return 0
  fi
  if [ "$extra" = cgos ]; then
    # Chainguard OS ends the session scope with the login (a `setsid nohup`
    # job died with the ssh session, 2026-09-19); a transient system unit
    # running as the login user outlives it.
    say "running matrix-cell.sh as a transient systemd unit"
    matrix_ssh "$dest" "rm -f ~/logs/done; sudo systemd-run --collect --quiet --unit=challoc-matrix-\$(date +%s) --uid=\$(id -u) --gid=\$(id -g) --setenv=HOME=\$HOME --working-directory=\$HOME/challoc bash -c 'bash ~/challoc/bench/gce/matrix-cell.sh $cell $image $extra > ~/logs/matrix.log 2>&1; echo \$? > ~/logs/done'; sleep 1; echo launched" >>"$log" 2>&1 || say "launch ssh returned nonzero (the run may still be going)"
  else
  say "running matrix-cell.sh detached (a new login, so the docker group applies)"
  matrix_ssh "$dest" "rm -f ~/logs/done; (setsid nohup bash -c 'bash ~/challoc/bench/gce/matrix-cell.sh $cell $image $extra; echo \$? > ~/logs/done' > ~/logs/matrix.log 2>&1 < /dev/null &); sleep 1; echo launched" >>"$log" 2>&1 || say "launch ssh returned nonzero (the run may still be going)"
  fi
  # Poll for the done marker until the deadline; a lost connection while
  # polling is not fatal.
  rc=timeout
  while [ "$(date +%s)" -lt "$deadline" ]; do
    sleep 30
    local d; d="$(matrix_ssh "$dest" 'if [ -f ~/logs/done ]; then echo "DONE=$(cat ~/logs/done)"; fi' 2>/dev/null || true)"
    case "$d" in
      DONE=*) rc="${d#DONE=}"; break ;;
    esac
  done
  say "run finished: rc=$rc after $(( $(date +%s) - t0 )) s; fetching ~/logs"
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/challoc-matrix-$cell.XXXXXX")"
  # shellcheck disable=SC2046
  rsync -az -e "ssh $(matrix_ssh_opts)" "$dest:logs/" "$tmp/" >>"$log" 2>&1 || say "fetch failed (partial logs)"
  if [ "$extra" = scorecard ] || [ "$extra" = cgos ]; then
    # The per-CPU scorecard file the VM wrote (bench/results/scorecard-<family>.md,
    # scorecard-cgos-<arch>.md for a Chainguard OS cell), next to the
    # reference files; the VM's copy is the whole file, and a rerun of the
    # same (date, commit) replaces its line there, so the copy is the record.
    local sc="scorecard-${machine%%-*}.md"
    # (the cell name's prefix: cgos-* -> scorecard-cgos-<arch>.md, cgos72-* ->
    # scorecard-cgos72-<arch>.md, so kernels do not share a trend file).
    [ "$extra" != cgos ] || sc="scorecard-${cell%-*}-$arch.md"
    # shellcheck disable=SC2046
    if rsync -az -e "ssh $(matrix_ssh_opts)" "$dest:$REMOTE_DIR/bench/results/$sc" "$REPO/bench/results/$sc" >>"$log" 2>&1; then
      say "fetched bench/results/$sc"
    else
      say "no bench/results/$sc on the VM (the scorecard step failed before appending)"
    fi
  fi
  {
    echo
    echo "==================== ~/logs/matrix.log on $vm ===================="
    cat "$tmp/matrix.log" 2>/dev/null || echo "(no matrix.log)"
    if [ -f "$tmp/cpuinfo.log" ]; then
      echo
      echo "==================== ~/logs/cpuinfo.log ===================="
      cat "$tmp/cpuinfo.log"
    fi
    for f in image test probe probe-privileged probe-native host fuzz test-cgroup test-privileged scorecard; do
      [ -f "$tmp/$f.log" ] || continue
      echo
      echo "==================== ~/logs/$f.log (last 60 lines) ===================="
      tail -n 60 "$tmp/$f.log"
    done
    # Every failed test's own output, for the results file's FAIL lines.
    if grep -q '^failures:' "$tmp/test.log" 2>/dev/null; then
      echo
      echo "==================== failures in make test ===================="
      awk '/^failures:$/ { on = 1 } on { print } /^test result:/ { on = 0 }' "$tmp/test.log" | head -n 400
      # With --nocapture the panic message is not in that block: it went to
      # stderr as it happened, on the line after `panicked at`. Every panic
      # (the should_panic tests' expected ones included) with its message.
      echo "-- every panic with its message:"
      grep -A1 "panicked at" "$tmp/test.log" | grep -v '^--$' | head -n 300
    fi
  } >> "$log"
  rm -rf "$tmp"
  [ "$rc" != timeout ] || matrix_fail timeout '?' '?'
  summary="$(grep '^MATRIX ' "$log" | tail -1)"
  say "$summary"
  case "$summary" in *outcome=PASS*) return 0 ;; *) return 1 ;; esac
}

# matrix_clean: delete every matrix VM in every zone (the CPU cells live in
# more than one).
matrix_clean() {
  local vms n z pids=
  vms="$(g compute instances list --filter="name~^$MATRIX_PREFIX-" --format='value(name,zone.basename())' 2>/dev/null || true)"
  [ -n "$vms" ] || { echo "challoc-bench: matrix: no $MATRIX_PREFIX-* VM exists"; return 0; }
  echo "challoc-bench: matrix: deleting $(echo "$vms" | awk '{ printf "%s(%s) ", $1, $2 }')"
  # A here-string, not a pipeline: the loop must run in this shell so that
  # `wait` below waits for the deletes (a pipeline's subshell would own them
  # and exit at once, leaving the VMs running behind a finished `clean`).
  while read -r n z; do
    [ -n "$n" ] || continue
    matrix_delete_vm "$n" "$z" &
    pids="$pids $!"
  done <<<"$vms"
  # shellcheck disable=SC2086
  wait $pids
  g compute instances list --filter="name~^$MATRIX_PREFIX-" --format='value(name,zone.basename(),status)' 2>/dev/null | sed 's/^/challoc-bench: matrix: still present: /'
}

cmd_matrix() {
  local what="${1:-}"
  case "$what" in
    list)
      printf '%-11s %-22s %-16s %-6s %-15s %-5s %-10s %s\n' cell family project arch machine prep extra zones
      for c in $MATRIX_CELLS $MATRIX_CPU_CELLS $MATRIX_CGOS_CELLS; do printf '%-11s %s %s\n' "$c" "$(cell_spec "$c" | awk '{ printf "%-22s %-16s %-6s %-15s %-5s %-10s", $1, $2, $3, $4, $5, $6 }')" "$(cell_zones "$c" | tr ' ' ',')"; done
      return 0 ;;
    cpu) shift; set -- $MATRIX_CPU_CELLS "$@" ;;
    cgos) shift; set -- $MATRIX_CGOS_CELLS "$@" ;;
    clean) matrix_clean; return 0 ;;
    lab)
      shift
      [ $# -ge 1 ] || die "matrix lab: which cell? (matrix list)"
      local c rc=0
      for c in "$@"; do cell_spec "$c" >/dev/null || die "matrix: unknown cell $c (matrix list)"; done
      MATRIX_LAB=1; MATRIX_OUT="$REPO/.tmp-matrix-lab"; mkdir -p "$MATRIX_OUT"
      for c in "$@"; do ( matrix_cell "$c" ) || rc=1; done
      return $rc ;;
    ssh)
      shift; local dest; dest="$(matrix_lab_dest "${1:?matrix ssh: which cell?}")"; shift
      matrix_ssh "$dest" "$@"; return ;;
    sync)
      shift; local dest; dest="$(matrix_lab_dest "${1:?matrix sync: which cell?}")"
      rsync_tree "ssh $(matrix_ssh_opts)" "$dest"; return ;;
  esac
  local cells="${*:-$MATRIX_CELLS}" c pids= failed=0
  for c in $cells; do cell_spec "$c" >/dev/null || die "matrix: unknown cell $c (matrix list)"; done
  mkdir -p "$MATRIX_OUT"
  echo "challoc-bench: matrix: cells: $cells; $MATRIX_JOBS at a time, ${MATRIX_TIMEOUT}s each; logs in $MATRIX_OUT/$MATRIX_DATE-<cell>.log"
  [ -z "$(git -C "$REPO" status --porcelain -- src Cargo.toml Cargo.lock build.rs 2>/dev/null)" ] \
    || echo "challoc-bench: matrix: WARNING: uncommitted library changes are being synced; a scorecard line would be marked '+'" >&2
  # On any exit: stop the cells (their own traps delete their VMs), then
  # sweep the zone for anything left.
  # `set -e` applies inside the trap too: every step here must not fail
  # (a pkill that finds no children returns 1), or the sweep never runs.
  trap 'echo "challoc-bench: matrix: cleaning up"; for p in ${pids:-}; do pkill -TERM -P "$p" 2>/dev/null || true; kill -TERM "$p" 2>/dev/null || true; done; wait 2>/dev/null || true; matrix_clean || true; g compute instances list --filter="name~^$MATRIX_PREFIX-" 2>/dev/null || true' EXIT
  trap 'exit 130' INT TERM HUP
  for c in $cells; do
    while [ "$(jobs -rp | wc -l | tr -d ' ')" -ge "$MATRIX_JOBS" ]; do sleep 15; done
    ( matrix_cell "$c" ) &
    pids="$pids $!"
    sleep 5
  done
  for p in $pids; do wait "$p" || failed=$((failed + 1)); done
  echo
  echo "challoc-bench: matrix: summary ($MATRIX_DATE)"
  for c in $cells; do grep -h '^MATRIX ' "$MATRIX_OUT/$MATRIX_DATE-$c.log" 2>/dev/null | tail -1 || echo "MATRIX cell=$c outcome=MISSING"; done
  [ "$failed" = 0 ]
}

cmd="${1:-}"; shift || true
case "$cmd" in
  create)    cmd_create "$@" ;;
  provision) cmd_provision "$@" ;;
  sync)      cmd_sync "$@" ;;
  run)       cmd_run "$@" ;;
  make)      cmd_make "$@" ;;
  quick)     cmd_quick "$@" ;;
  ab)        cmd_ab "$@" ;;
  quick-perf) cmd_quick_perf "$@" ;;
  scorecard) cmd_scorecard "$@" ;;
  pmu-check) cmd_pmu_check "$@" ;;
  perf-stat) cmd_perf_stat "$@" ;;
  fetch)     cmd_fetch "$@" ;;
  ssh)       cmd_ssh "$@" ;;
  status)    cmd_status ;;
  lanes)     cmd_lanes ;;
  start)     cmd_start "$@" ;;
  stop)      cmd_stop "$@" ;;
  session)   cmd_session "$@" ;;
  delete)    cmd_delete "$@" ;;
  matrix)    cmd_matrix "$@" ;;
  *) sed -n '2,/^set -euo pipefail/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
