axiom_getrandom_count	platform/kernel fact	none (assumption)
axiom_read_count	platform/kernel fact	none (assumption)
axiom_write_count	platform/kernel fact	none (assumption)
getrandom_exact	termination	none (assumption)
read_full	termination	none (assumption)
write_all	termination	none (assumption)
# The calling thread's signal mask (the kernel's per-thread state).
axiom_thread_mask	platform/kernel fact	none (assumption)
# Inline assembly checked with Isla (verus/ISLA.md) up to the exception it
# takes: run.sh checks it against the contract verus/isla/seams.md quotes.
trap	inline asm	Islaris/Isla	trusted (partly checked, Isla: verus/isla/seams.md; not checked: K2 (no resume past the trap))
# glibc's thread pointer: tells threads of one process apart, kept by the
# forking thread in a fork child (the fork window's holder, the init/fork gate).
pthread_self	FFI/syscall	none (assumption)
