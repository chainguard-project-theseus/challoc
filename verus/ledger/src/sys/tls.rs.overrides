# The slot premise: each top-level user of the slot gets a token as the
# slot's last user left it.
TlsSlot::entry	allocator invariant	none (assumption)
# Inline assembly checked with Isla (verus/ISLA.md): run.sh checks the
# memory each reads or writes and the registers it writes against the
# contract verus/isla/seams.md quotes; what the slot holds rests on P8
# there and the slot premise above.
get	inline asm	Islaris/Isla	trusted (partly checked, Isla: verus/isla/seams.md; not checked: P8 (the GOT entry holds the slot's TLS offset) and the TLS slot premise)
get_tp	inline asm	Islaris/Isla	trusted (partly checked, Isla: verus/isla/seams.md; not checked: P8 (the GOT entry holds the slot's TLS offset), the TLS slot premise and TlsCell::tp (TPIDR_EL0 is the cell's tp))
set	inline asm	Islaris/Isla	trusted (partly checked, Isla: verus/isla/seams.md; not checked: P8 (the GOT entry holds the slot's TLS offset) and the TLS slot premise)
