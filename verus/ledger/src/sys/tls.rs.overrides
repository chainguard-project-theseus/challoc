# The slot premise: each top-level user of the slot gets a token as the
# slot's last user left it.
TlsSlot::entry	allocator invariant	none (assumption)
# Inline assembly checked with Isla (verus/ISLA.md): run.sh checks the
# memory each reads or writes and the registers it writes against the
# contract verus/isla/seams.md quotes; what the slot holds rests on P8
# there and the slot premise above.
get	inline asm	Islaris/Isla	trusted (partly checked, Isla: verus/isla/seams.md; not checked: P8 (the GOT entry holds the slot's TLS offset) and the TLS slot premise)	contract 584579997, body 90234313, spec 3066003437
get_tp	inline asm	Islaris/Isla	trusted (partly checked, Isla: verus/isla/seams.md; not checked: P8 (the GOT entry holds the slot's TLS offset), the TLS slot premise and TlsCell::tp (TPIDR_EL0 is the cell's tp))	contract 900674773, body 3050843110, spec 2422367595
set	inline asm	Islaris/Isla	trusted (partly checked, Isla: verus/isla/seams.md; not checked: P8 (the GOT entry holds the slot's TLS offset) and the TLS slot premise)	contract 2478902706, body 3452213169, spec 2018223471
