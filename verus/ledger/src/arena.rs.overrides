# The build checks the array layout at each instance the proofs use (the
# `const` assertions after `Arena`'s, `Arenas`'s, `Shared`'s and
# `Tcaches`'s layouts).
axiom_array_layout	core library	Kani	trusted (partly checked, const assert: `axiom_array_layout` at `Arena::split`'s instance in src/arena.rs, `axiom_array_layout` at `Arenas::split`'s two instances in src/arena.rs, `arena::axiom_array_layout` at `split`'s two instances in src/heap/shared.rs, `arena::axiom_array_layout` at `Tcaches::split`'s instance in src/heap/tcaches.rs, and Kani: arena::kani_array_layout::array_layout_samples; not checked: the axiom is generic in `T` and `N`, and these check only the six instances the proofs use and the sampled ones)
# Byte offsets (`offset_of!`, which Verus cannot evaluate), and the
# layout the build checks with `fits`.
A_INDEX	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
A_DECAY_NS	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
A_SETS	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
A_SETS_PERM	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
A_CLASSES	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
A_LARGE	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
A_STATS	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
A_LAST_EXIT_PURGE	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
axiom_arena_layout	core library	Kani	discharged (const assert: `axiom_arena_layout` in src/arena.rs)
# Joining typed field permissions into the struct's: no vstd counterpart.
axiom_arena_assemble	raw pointer (internal)	none (assumption)
# `core`'s tuple and `bool` order, as documented.
key_less	core library	Kani	discharged (Kani: arena::kani_key_less::key_less_is_key_lt)
# `Arenas`'s byte offsets and layout, which the build checks with `fits`.
AR_TABLE	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_BOUND	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_LOCK	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_COUNT	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_AUTO	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_SPARE	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_INVS	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_COUNT_INV	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
AR_SPARE_INV	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
axiom_arenas_layout	core library	Kani	discharged (const assert: `axiom_arenas_layout` in src/arena.rs)
# Joining typed field permissions into the struct's: no vstd counterpart.
axiom_arenas_assemble	raw pointer (internal)	none (assumption)
# The build-cost table's initialiser: `[NO_COST; BUILD_COSTS]`, an
# array-repeat expression Verus does not take for an element type that is
# not `Copy`, and the arena storage rounded up with
# `usize::next_multiple_of`, which vstd does not specify. Both claim
# nothing, and both are evaluated at compile time.
NO_COSTS	core library	none (assumption)
ARENA_STORAGE	core library	none (assumption)
# The smallest-sample loop retries a weak compare-and-exchange while other
# threads store smaller samples, or spuriously: no bound to check.
note_build_cost	termination	none (assumption)
