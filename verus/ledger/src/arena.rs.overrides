# The build checks the array layout at each instance used (the const
# assertion after `Arena`'s layout).
axiom_array_layout	core library	Kani
# Byte offsets (`offset_of!`, which Verus cannot evaluate), and the
# layout the build checks with `fits`.
A_INDEX	core library	Kani
A_DECAY_NS	core library	Kani
A_SETS	core library	Kani
A_SETS_PERM	core library	Kani
A_CLASSES	core library	Kani
A_LARGE	core library	Kani
A_STATS	core library	Kani
A_LAST_EXIT_PURGE	core library	Kani
axiom_arena_layout	core library	Kani
# Joining typed field permissions into the struct's: no vstd counterpart.
axiom_arena_assemble	raw pointer (internal)	none (assumption)
# `core`'s tuple and `bool` order, as documented.
key_less	core library	Kani
# `Arenas`'s byte offsets and layout, which the build checks with `fits`.
AR_TABLE	core library	Kani
AR_BOUND	core library	Kani
AR_LOCK	core library	Kani
AR_COUNT	core library	Kani
AR_AUTO	core library	Kani
AR_SPARE	core library	Kani
AR_INVS	core library	Kani
AR_COUNT_INV	core library	Kani
AR_SPARE_INV	core library	Kani
axiom_arenas_layout	core library	Kani
# Joining typed field permissions into the struct's: no vstd counterpart.
axiom_arenas_assemble	raw pointer (internal)	none (assumption)
# The creation lock's invariant (lock_inv is uninterpreted); its writers
# are verified.
axiom_arenas_lock_inv	allocator invariant	none (assumption)
# The creation lock's frame, as lock.rs's other frame axioms.
axiom_arenas_lock_frame	allocator invariant	none (assumption)
