# Temporary seams, provable in Verus once the claim hands out permissions
# to the slots' memory and the aborts are specified.
ClassState::check_fresh_slab_is_zero	panic/abort	Verus
ClassState::check_shadow	panic/abort	Verus
# Trusted abort: Verus does not model the formatted message.
fresh_with_live	panic/abort	Verus
# Temporary seam, provable in Verus once the claim hands out permissions
# to the slots' memory: its raw reads of the slots are trusted.
ClassState::check_zero	raw pointer (internal)	Verus
