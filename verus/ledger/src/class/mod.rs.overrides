# The lock contract, as for lock.rs's axiom_acquired and axiom_held.
axiom_class_lock_inv	allocator invariant	none (assumption)
axiom_class_lock	allocator invariant	none (assumption)
# Temporary seams, provable in Verus: the descriptor bridges, until their
# proofs show the permission they use is the descriptor's.
ClassState::state_locked	raw pointer (internal)	Verus
ClassState::set_state_locked	raw pointer (internal)	Verus
ClassState::set_dirty_locked	raw pointer (internal)	Verus
