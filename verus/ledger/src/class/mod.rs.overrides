# The lock contract, as for lock.rs's axiom_acquired and axiom_held.
axiom_class_lock_inv	allocator invariant	none (assumption)
axiom_class_lock	allocator invariant	none (assumption)
# Kernel facts at the refill: a Fresh slab's slots read as zero (mmap), and
# a Purged one's while every discard was MADV_DONTNEED (madvise).
axiom_fresh_slots_zero	allocator invariant	none (assumption)
axiom_discarded_slots_zero	allocator invariant	none (assumption)
# Temporary seam, provable in Verus: the owner word's read is not verified yet.
ClassState::take_checks	panic/abort	Verus
