# The table lock guards `()`: its invariant is `true`.
axiom_tcaches_lock_inv	allocator invariant	none (assumption)
# `Tcaches`'s byte offsets and layout, which the build checks with `fits`.
T_TABLE	core library	Kani	discharged (const assert: `axiom_tcaches_layout` in src/heap/tcaches.rs)
T_LOCK	core library	Kani	discharged (const assert: `axiom_tcaches_layout` in src/heap/tcaches.rs)
T_INV	core library	Kani	discharged (const assert: `axiom_tcaches_layout` in src/heap/tcaches.rs)
axiom_tcaches_layout	core library	Kani	discharged (const assert: `axiom_tcaches_layout` in src/heap/tcaches.rs)
# Joining typed field permissions into the struct's: no vstd counterpart.
axiom_tcaches_assemble	raw pointer (internal)	none (assumption)
# The C caller uses an explicit cache on one thread at a time, and a
# heap's key destructor runs once: each call that reaches an existing
# heap through `heap_at` makes one token, before any reference it lends.
axiom_heap_use	C-program contract	none (assumption)
# A raw-pointer dereference: a live heap from creation is well formed and
# has its home headers at `p`. The reference borrows the caller's
# `HeapUse` token, so one token gives one reference at a time; two
# tokens rest on `axiom_heap_use`'s premise.
heap_at	allocator invariant	none (assumption)
