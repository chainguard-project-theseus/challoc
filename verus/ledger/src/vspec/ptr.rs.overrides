axiom_ptr_add_addr	core library	Kani
axiom_array_elem	core library	none (assumption)
axiom_array_view	core library	none (assumption)
axiom_raw_valid	raw pointer (internal)	none (assumption)
# A `u64` has no padding and every bit pattern is a value.
axiom_plain_u64	core library	none (assumption)
# Integers: no padding, and every bit pattern is a value.
axiom_plain_u8	core library	none (assumption)
axiom_plain_usize	core library	none (assumption)
# Any address is a valid raw pointer value; the value carries no usable provenance.
axiom_plain_ptr	core library	none (assumption)
