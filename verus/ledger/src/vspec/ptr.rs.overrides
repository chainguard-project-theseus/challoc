axiom_plain_isize	core library	Kani	discharged (Kani: kani_proofs::ptr::plain_bytes_are_values)
axiom_plain_u32	core library	Kani	discharged (Kani: kani_proofs::ptr::plain_bytes_are_values)
# The value carries no usable provenance: a restriction on the proofs, not checked.
axiom_plain_ptr	core library	Kani	discharged (Kani: kani_proofs::ptr::plain_bytes_are_values)
