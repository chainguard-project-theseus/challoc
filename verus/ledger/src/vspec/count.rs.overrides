# Kani runs each wrapper on a real atomic, one thread (src/kani/atomic.rs).
fetch_add	atomics primitive	loom/GenMC	trusted (partly checked, Kani: kani_proofs::atomic::count_fetch_add; not checked: concurrent interleavings, where the orderings matter, and that the permission's value is the atomic's (the harness assumes every write goes through these wrappers))
fetch_sub	atomics primitive	loom/GenMC	trusted (partly checked, Kani: kani_proofs::atomic::count_fetch_sub; not checked: concurrent interleavings, where the orderings matter, and that the permission's value is the atomic's (the harness assumes every write goes through these wrappers))
store	atomics primitive	loom/GenMC	trusted (partly checked, Kani: kani_proofs::atomic::count_store; not checked: concurrent interleavings, where the orderings matter, and that the permission's value is the atomic's (the harness assumes every write goes through these wrappers))
load	atomics primitive	loom/GenMC	trusted (partly checked, Kani: kani_proofs::atomic::count_load; not checked: concurrent interleavings, where the orderings matter, and that the permission's value is the atomic's (the harness assumes every write goes through these wrappers))
swap	atomics primitive	loom/GenMC	trusted (partly checked, Kani: kani_proofs::atomic::count_swap; not checked: concurrent interleavings, where the orderings matter, and that the permission's value is the atomic's (the harness assumes every write goes through these wrappers))
compare_exchange	atomics primitive	loom/GenMC	trusted (partly checked, Kani: kani_proofs::atomic::count_compare_exchange; not checked: concurrent interleavings, where the orderings matter, and that the permission's value is the atomic's (the harness assumes every write goes through these wrappers))
