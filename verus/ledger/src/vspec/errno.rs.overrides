# libc's errno pointer, which Verus does not model.
set_errno	FFI/syscall	none (assumption)
# Also claims the value read is the token's: that no libc call in trusted
# code wrote errno since challoc's last write in this C call (or, before
# any, since the call began).
get_errno	FFI/syscall	none (assumption)
# The export wrappers' token for the calling thread's errno, ghost only.
lend	C-program contract	none (assumption)
# The errno the C caller reads when an export returns is the lent token's
# final value: get_errno's assumption, carried to the return.
axiom_errno_at_return	C-program contract	none (assumption)
