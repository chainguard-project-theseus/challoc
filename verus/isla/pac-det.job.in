# Determinism of one PAC instruction at a site (verus/isla/seams.md):
# copy `a` runs the canonical `@OP@ x0, x1`, copy `b` the
# site's `@OP@ @D@, @N@`, from independent states in the same configuration
# (pac-footprint.job.in). Given the same pointer, modifier, data key A and
# SCTLR.EnDA, they give the same result: the instruction computes one
# function of those four, whatever the registers. ComputePAC is
# uninterpreted and shared by the copies. In the Armv9.4-A configurations
# run.sh adds `pc-step` and, for `autda`, the `stop` line and the assertion
# that both copies fault (end at the FPAC call) or neither does.
abstract ComputePAC
writes R0 @D@
no-mem-write
mem-reads 0
flags-preserved
# The key registers are read only when EnDA is set.
decl a.init.APDAKeyHi_EL1 64
decl a.init.APDAKeyLo_EL1 64
decl b.init.APDAKeyHi_EL1 64
decl b.init.APDAKeyLo_EL1 64
assume (= a.init.R0 b.init.@D@)
assume (= a.init.R1 b.init.@N@)
assume (= a.init.APDAKeyHi_EL1 b.init.APDAKeyHi_EL1)
assume (= a.init.APDAKeyLo_EL1 b.init.APDAKeyLo_EL1)
assume (= ((_ extract 27 27) a.init.@SCTLR@) ((_ extract 27 27) b.init.@SCTLR@))
assert (= a.final.R0 b.final.@D@)
