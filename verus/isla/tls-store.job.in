# The TLS slot store (tls::set's aarch64 asm; verus/isla/seams.md):
#   adrp @A@, :gottprel:challoc_tls      (R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21)
#   ldr  @A@, [@A@, :gottprel_lo12:...]  (R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC)
#   mrs  @B@, tpidr_el0
#   str  @C@, [@B@, @A@]
# run.sh prepends the four insn lines and `writes` (A and B: C is the
# value, an input). Assumptions as in tls-load.job.in.
flags-preserved
mem-reads 1
mem-writes 1
decl got 64
assume (= (concat seg.1.immhi seg.1.immlo) ((_ extract 32 12) (bvsub (bvand got #xfffffffffffff000) (bvand init._PC #xfffffffffffff000))))
assume (= ((_ sign_extend 31) ((_ extract 32 0) (bvsub (bvand got #xfffffffffffff000) (bvand init._PC #xfffffffffffff000)))) (bvsub (bvand got #xfffffffffffff000) (bvand init._PC #xfffffffffffff000)))
assume (= seg.2.imm12 ((_ zero_extend 3) ((_ extract 11 3) got)))
assume (= ((_ extract 2 0) got) #b000)
assume (bvult init._PC #x0001000000000000)
assume (bvult got #x0001000000000000)
decl mem.1.val 64
assume (bvult (bvadd init.TPIDR_EL0 mem.1.val) #x0001000000000000)
assume (= ((_ extract 2 0) (bvadd init.TPIDR_EL0 mem.1.val)) #b000)
# The load reads exactly the GOT entry; the one store writes the value to
# the thread pointer plus the offset it held, 8 bytes; A and B end as the
# offset and the thread pointer; the sequence falls through.
assert (= mem.1.addr got)
assert (= wmem.1.addr (bvadd init.TPIDR_EL0 mem.1.val))
assert (= wmem.1.val init.@C@)
assert (= final.@B@ init.TPIDR_EL0)
assert (= final.@A@ mem.1.val)
assert (= final._PC (bvadd init._PC #x0000000000000010))
